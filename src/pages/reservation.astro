---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PlanityBooking from "../components/PlanityBooking.astro";
---

<BaseLayout
  title="Prendre rendez-vous | Appart & Beauté Marseille 11e"
  description="Prenez rendez-vous en ligne chez Appart & Beauté à La Valentine, Marseille 11e. Choisissez votre prestation et votre créneau directement via Planity."
>
  <Header />

  <main class="reservation-page">
    <section class="reservation-intro">
      <div class="container reservation-heading" data-reveal>
        <p class="eyebrow">Réservation</p>

        <h1>
          Choisir votre
          <span>rendez-vous</span>
        </h1>

        <span class="heading-line" aria-hidden="true"></span>

        <p class="intro">
          Choisissez votre prestation puis le créneau qui vous convient. Les
          disponibilités affichées sont directement synchronisées avec l’agenda
          Planity de Marjorie.
        </p>
      </div>
    </section>

    <section class="booking-section">
      <div class="container">
        <aside
          class="booking-note"
          aria-label="Informations pratiques"
          data-reveal
        >
          <p class="booking-note-title">À savoir avant votre rendez-vous</p>
          <p>
            L’institut est situé au 1er étage · Paiement en espèces ou par
            chèque.
          </p>
        </aside>

        <div class="booking-card" data-reveal style="--reveal-delay: 80ms">
          <PlanityBooking />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  (() => {
    const POPUP_SELECTOR = '[class*="business_popup-module_businessPopup"]';

    const normalizeText = (value = "") =>
      value.toLowerCase().replace(/[’']/g, "").replace(/\s+/g, " ").trim();

    const dismissPlanityBusinessMessage = () => {
      const popup = document.querySelector(POPUP_SELECTOR);
      if (!popup) return false;

      const button = [...popup.querySelectorAll("button")].find((candidate) =>
        normalizeText(candidate.textContent).includes("jai compris"),
      );

      if (!button) return false;

      button.click();
      return true;
    };

    const observer = new MutationObserver(() => {
      dismissPlanityBusinessMessage();
    });

    const startObserver = () => {
      observer.observe(document.body, {
        childList: true,
        subtree: true,
      });

      dismissPlanityBusinessMessage();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startObserver, {
        once: true,
      });
    } else {
      startObserver();
    }
  })();
</script>

<style>
  .reservation-page {
    background: var(--color-bg-soft);
  }

  .reservation-intro {
    padding: 108px 0 34px;
    background: var(--color-bg-soft);
  }

  .reservation-heading {
    max-width: 1180px;
  }

  .reservation-heading h1 {
    max-width: 760px;
    margin-top: 8px;
    font-size: clamp(3rem, 12vw, 4.45rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .reservation-heading h1 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 18px;
    background: var(--color-terracotta);
  }

  .intro {
    max-width: 650px;
    margin-top: 20px;
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.68;
  }

  .booking-section {
    padding: 12px 0 58px;
    background: var(--color-bg-soft);
  }

  .booking-note {
    max-width: 760px;
    margin: 10px 0 0;
    padding: 15px 18px;
    border-left: 2px solid var(--color-terracotta);
    background: rgba(196, 119, 91, 0.08);
    color: var(--color-text-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .booking-note p {
    margin: 0;
  }

  .booking-note-title {
    margin-bottom: 3px !important;
    color: var(--color-text);
    font-weight: 600;
  }

  .booking-card {
    margin-top: 28px;
    overflow: hidden;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  @media (min-width: 700px) {
    .reservation-intro {
      padding: 145px 0 46px;
    }

    .reservation-heading h1 {
      font-size: 5.2rem;
    }

    .intro {
      font-size: 1rem;
    }

    .booking-section {
      padding: 12px 0 78px;
    }
  }

  @media (min-width: 1000px) {
    .reservation-intro {
      padding: 170px 0 54px;
    }

    .reservation-heading h1 {
      font-size: clamp(5rem, 5.7vw, 6.3rem);
    }

    .heading-line {
      width: 68px;
    }

    .booking-section {
      padding: 14px 0 96px;
    }

    .booking-card {
      border-radius: 34px;
    }
  }
</style>
