---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PlanityBooking from "../components/PlanityBooking.astro";
---

<BaseLayout
  title="Prendre rendez-vous | Appart & Beauté Marseille 11e"
  description="Prenez rendez-vous en ligne chez Appart & Beauté à La Valentine, Marseille 11e. Choisissez votre prestation et votre créneau directement via Planity."
>
  <Header />

  <main class="reservation-page">
    <section class="reservation-intro">
      <div class="container reservation-heading" data-reveal>
        <p class="eyebrow">Réservation</p>

        <h1>
          Choisir votre
          <span>rendez-vous</span>
        </h1>

        <span class="heading-line" aria-hidden="true"></span>

        <p class="intro">
          Choisissez votre prestation puis le créneau qui vous convient.
          Les disponibilités affichées sont directement synchronisées avec
          l’agenda Planity de Marjorie.
        </p>
      </div>
    </section>

    <section class="booking-section">
      <div class="container">
        <div class="booking-card" data-reveal style="--reveal-delay: 80ms">
          <PlanityBooking />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .reservation-page {
    background: var(--color-bg-soft);
  }

  .reservation-intro {
    padding: 108px 0 34px;
    background: var(--color-bg-soft);
  }

  .reservation-heading {
    max-width: 1180px;
  }

  .reservation-heading h1 {
    max-width: 760px;
    margin-top: 8px;
    font-size: clamp(3rem, 12vw, 4.45rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .reservation-heading h1 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 18px;
    background: var(--color-terracotta);
  }

  .intro {
    max-width: 650px;
    margin-top: 20px;
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.68;
  }

  .booking-section {
    padding: 12px 0 58px;
    background: var(--color-bg-soft);
  }

  .booking-card {
    overflow: hidden;
    border-radius: 28px;
    background: #fffdfb;
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 700px) {
    .reservation-intro {
      padding: 145px 0 46px;
    }

    .reservation-heading h1 {
      font-size: 5.2rem;
    }

    .intro {
      font-size: 1rem;
    }

    .booking-section {
      padding: 12px 0 78px;
    }
  }

  @media (min-width: 1000px) {
    .reservation-intro {
      padding: 170px 0 54px;
    }

    .reservation-heading h1 {
      font-size: clamp(5rem, 5.7vw, 6.3rem);
    }

    .heading-line {
      width: 68px;
    }

    .booking-section {
      padding: 14px 0 96px;
    }

    .booking-card {
      border-radius: 34px;
    }
  }
</style>
