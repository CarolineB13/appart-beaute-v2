---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PlanityBookingCompact from "../components/PlanityBooking-compact.astro";

import browliftPrestationImage from "../assets/images/regard/browlift-prestation.webp";
import browliftResultatImage from "../assets/images/regard/browlift-resultat.webp";
---

<BaseLayout
  title="Browlift à Marseille 11e | Appart & Beauté"
  description="Découvrez le Browlift chez Appart & Beauté à La Valentine, Marseille 11e : une technique pour discipliner, restructurer et mettre en valeur les sourcils naturels."
>
  <Header />

  <main>
    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="brow-hero">
      <div class="container brow-hero-grid">
        <div class="brow-hero-copy" data-reveal>
          <a class="back-link" href="/prestations/#regard">
            <span aria-hidden="true">←</span>
            Beauté du regard
          </a>

          <p class="eyebrow">Browlift · Marseille 11e</p>

          <h1>
            Révéler vos sourcils
            <span>tout en naturel</span>
          </h1>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="hero-text">
            Une technique pensée pour discipliner et redessiner les sourcils
            naturels, combler visuellement les petits manques et structurer le
            regard sans tatouage.
          </p>

          <a class="primary-button" href="#reservation-browlift">
            Réserver
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div
          class="brow-hero-visual"
          data-reveal="image"
          style="--reveal-delay: 80ms"
        >
          <Image
            src={browliftResultatImage}
            alt="Résultat d’un Browlift chez Appart & Beauté à Marseille 11e"
            widths={[520, 760, 980, 1200]}
            sizes="(min-width: 1000px) 48vw, 100vw"
          />
        </div>
      </div>
    </section>

    <!-- =====================================================
         QU'EST-CE QUE LE BROWLIFT
         ===================================================== -->

    <section class="about-section">
      <div class="container about-grid">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Le principe</p>

          <h2>
            Le
            <span>Browlift</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>
        </div>

        <div class="about-copy" data-reveal style="--reveal-delay: 80ms">
          <p>
            Souvent comparé à une permanente pour les sourcils, le Browlift
            redresse et repositionne les poils afin de redessiner naturellement
            la ligne.
          </p>

          <p>
            Il ne s’agit ni d’un tatouage ni d’un microblading : la pigmentation
            de la peau n’est pas modifiée, le travail se fait uniquement sur les
            poils naturels du sourcil.
          </p>
        </div>
      </div>

      <div class="container benefits-grid">
        <article class="benefit-card" data-reveal>
          <p class="benefit-kicker">01</p>
          <h3>Sourcils disciplinés</h3>
          <p>Les poils sont assouplis et plus faciles à orienter.</p>
        </article>

        <article
          class="benefit-card"
          data-reveal
          style="--reveal-delay: 70ms"
        >
          <p class="benefit-kicker">02</p>
          <h3>Ligne structurée</h3>
          <p>Le sourcil paraît plus net et encadre davantage le regard.</p>
        </article>

        <article
          class="benefit-card"
          data-reveal
          style="--reveal-delay: 140ms"
        >
          <p class="benefit-kicker">03</p>
          <h3>Effet plus fourni</h3>
          <p>Le repositionnement des poils aide à combler visuellement les petits manques.</p>
        </article>
      </div>
    </section>

    <!-- =====================================================
         DÉROULEMENT
         ===================================================== -->

    <section class="process-section">
      <div class="container process-grid">
        <div class="process-image" data-reveal="image">
          <Image
            src={browliftPrestationImage}
            alt="Déroulement d’une prestation de Browlift"
            widths={[520, 760, 980]}
            sizes="(min-width: 1000px) 46vw, 100vw"
          />
        </div>

        <div class="process-copy" data-reveal style="--reveal-delay: 90ms">
          <p class="eyebrow">Le rendez-vous</p>

          <h2>
            Une heure
            <span>pour vos sourcils</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <div class="steps-list">
            <div>
              <strong>Observer</strong>
              <p>
                Marjorie commence par observer votre ligne naturelle, la
                direction des poils et le résultat recherché.
              </p>
            </div>

            <div>
              <strong>Assouplir</strong>
              <p>
                Une première lotion rend les poils plus malléables afin de
                pouvoir les repositionner.
              </p>
            </div>

            <div>
              <strong>Fixer</strong>
              <p>
                Les sourcils sont brossés dans la forme souhaitée puis une
                lotion fixatrice permet de maintenir le résultat.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         RÉSULTAT / TENUE
         ===================================================== -->

    <section class="results-section">
      <div class="container">
        <header class="results-heading" data-reveal>
          <p class="eyebrow">En pratique</p>

          <h2>
            Le Browlift
            <span>en deux repères</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>
        </header>

        <div class="results-grid">
          <article class="result-card" data-reveal>
            <strong>1 h</strong>
            <span>Durée du Browlift proposé actuellement sur Planity</span>
          </article>

          <article
            class="result-card"
            data-reveal
            style="--reveal-delay: 70ms"
          >
            <strong>4 à 6 semaines</strong>
            <span>Tenue généralement observée selon la nature des poils</span>
          </article>
        </div>

        <div class="duo-note" data-reveal style="--reveal-delay: 180ms">
          <div>
            <p class="eyebrow">Le duo regard</p>
            <h3>Browlift + Lash Lift Coréen</h3>
            <p>
              Pour travailler les sourcils et les cils lors du même rendez-vous,
              le forfait combiné est également disponible.
            </p>
          </div>

          <a href="#reservation-browlift">
            Voir les disponibilités
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- =====================================================
         RÉSERVATION
         ===================================================== -->

    <section class="booking-section" id="reservation-browlift">
      <div class="container">
        <header class="booking-heading" data-reveal>
          <p class="eyebrow">Réservation</p>

          <h2>
            Choisir votre
            <span>rendez-vous</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p>
            Sélectionnez le Browlift seul ou le forfait Lash Lift Coréen +
            Browlift, puis choisissez votre créneau.
          </p>
        </header>

        <div class="booking-card" data-reveal style="--reveal-delay: 80ms">
          <PlanityBookingCompact
            services={[
              "-OurTlOv9ZvyyeiI6l-I",
              "-OurU21PVXpcdhz_tTbL",
            ]}
            displayTitle="Browlift"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 18px;
    background: var(--color-terracotta);
  }

  .brow-hero,
  .process-section,
  .booking-section {
    background: var(--color-bg-soft);
  }

  .about-section,
  .results-section {
    background: var(--color-bg-warm);
  }

  .brow-hero {
    padding: 108px 0 54px;
  }

  .brow-hero-grid,
  .about-grid,
  .process-grid {
    display: grid;
    gap: 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    color: var(--color-text-soft);
    font-size: 0.75rem;
  }

  .brow-hero-copy h1,
  .section-heading h2,
  .process-copy h2,
  .results-heading h2,
  .booking-heading h2 {
    margin-top: 8px;
    font-size: clamp(2.9rem, 11vw, 4.35rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .brow-hero-copy h1 span,
  .section-heading h2 span,
  .process-copy h2 span,
  .results-heading h2 span,
  .booking-heading h2 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .hero-text,
  .about-copy p,
  .booking-heading > p:not(.eyebrow) {
    font-size: 0.94rem;
    line-height: 1.68;
  }

  .about-copy p + p {
    margin-top: 14px;
  }

  .primary-button {
    display: flex;
    width: min(100%, 280px);
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    padding: 13px 20px;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: white;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .brow-hero-visual,
  .process-image {
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .brow-hero-visual {
    height: 420px;
    border-radius: 105px 24px 24px 24px;
  }

  .brow-hero-visual img,
  .process-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brow-hero-visual img {
    object-position: center 42%;
  }

  .about-section,
  .process-section,
  .results-section,
  .booking-section {
    padding: 58px 0 66px;
  }

  .benefits-grid {
    display: grid;
    gap: 14px;
    margin-top: 36px;
  }

  .benefit-card {
    padding: 23px 20px;
    border: 1px solid rgba(159, 83, 61, 0.09);
    border-radius: 24px;
    background: rgba(255, 253, 251, 0.68);
  }

  .benefit-kicker {
    color: var(--color-terracotta);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .benefit-card h3 {
    margin-top: 8px;
    font-size: 1.65rem;
  }

  .benefit-card p:last-child {
    margin-top: 8px;
    font-size: 0.84rem;
    line-height: 1.56;
  }

  .process-image {
    height: 405px;
    border-radius: 24px 24px 105px 24px;
  }

  .process-image img {
    object-position: center 45%;
  }

  .steps-list {
    display: grid;
    gap: 18px;
    margin-top: 26px;
  }

  .steps-list > div {
    padding-left: 16px;
    border-left: 2px solid rgba(196, 119, 91, 0.3);
  }

  .steps-list strong {
    display: block;
    font-family: var(--font-title);
    font-size: 1.16rem;
    font-weight: 500;
  }

  .steps-list p {
    margin-top: 4px;
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .results-grid {
    display: grid;
    gap: 12px;
    margin-top: 34px;
  }

  .result-card {
    padding: 22px 20px;
    border: 1px solid rgba(159, 83, 61, 0.09);
    border-radius: 22px;
    background: rgba(255, 253, 251, 0.68);
  }

  .result-card strong {
    display: block;
    font-family: var(--font-title);
    font-size: 1.75rem;
    font-weight: 500;
  }

  .result-card span {
    display: block;
    margin-top: 5px;
    color: var(--color-text-soft);
    font-size: 0.81rem;
    line-height: 1.5;
  }

  .duo-note {
    margin-top: 18px;
    padding: 24px 21px;
    border-radius: 24px;
    background: var(--color-text);
    color: white;
  }

  .duo-note .eyebrow {
    color: var(--color-terracotta-light);
  }

  .duo-note h3 {
    margin-top: 6px;
    color: white;
    font-size: 1.8rem;
  }

  .duo-note p:not(.eyebrow) {
    margin-top: 9px;
    color: rgba(255, 253, 251, 0.72);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .duo-note > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: var(--color-terracotta-light);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .booking-section {
    scroll-margin-top: 90px;
  }

  .booking-card {
    margin-top: 28px;
    overflow: hidden;
    border-radius: 28px;
    background: #fffdfb;
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 700px) {
    .brow-hero {
      padding: 145px 0 74px;
    }

    .brow-hero-copy h1 {
      font-size: 5.2rem;
    }

    .brow-hero-visual {
      height: 520px;
    }

    .about-section,
    .process-section,
    .results-section,
    .booking-section {
      padding-top: 78px;
      padding-bottom: 88px;
    }

    .benefits-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .process-image {
      height: 500px;
    }

    .duo-note {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 40px;
      padding: 28px;
    }

    .duo-note > div {
      max-width: 580px;
    }

    .duo-note > a {
      flex: 0 0 auto;
      margin-top: 0;
    }
  }

  @media (min-width: 1000px) {
    .heading-line {
      width: 68px;
    }

    .brow-hero {
      padding: 170px 0 94px;
    }

    .brow-hero-grid {
      grid-template-columns: 0.94fr 1.06fr;
      align-items: center;
      gap: 74px;
    }

    .about-grid {
      grid-template-columns: 1fr 0.82fr;
      align-items: end;
      gap: 76px;
    }

    .process-grid {
      grid-template-columns: 1.02fr 0.98fr;
      align-items: center;
      gap: 78px;
    }

    .brow-hero-copy h1,
    .section-heading h2,
    .process-copy h2,
    .results-heading h2,
    .booking-heading h2 {
      font-size: clamp(4.2rem, 4.8vw, 5.3rem);
    }

    .brow-hero-visual {
      height: 620px;
      border-radius: 150px 32px 32px 32px;
    }

    .about-section,
    .process-section,
    .results-section,
    .booking-section {
      padding-top: 96px;
      padding-bottom: 105px;
    }

    .benefits-grid {
      gap: 20px;
      margin-top: 48px;
    }

    .benefit-card {
      min-height: 205px;
      padding: 27px 25px;
    }

    .process-image {
      height: 590px;
      border-radius: 32px 32px 150px 32px;
    }

    .results-grid {
      gap: 18px;
      margin-top: 42px;
    }

    .duo-note {
      margin-top: 24px;
      padding: 34px 36px;
      border-radius: 30px;
    }

    .booking-card {
      margin-top: 36px;
      border-radius: 34px;
    }
  }
</style>
