---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import onglerieImage from "../assets/images/prestations/prestation-onglerie.webp";
---

<BaseLayout
  title="Onglerie La Valentine Marseille 11e | Appart & Beauté"
  description="Onglerie à La Valentine, Marseille 11e : vernis semi-permanent mains et pieds, ongles en gel, comblage et beauté des mains chez Appart & Beauté."
>
  <Header />

  <main>
    <!-- =====================================================
         HERO
         ===================================================== -->
    <section class="service-hero">
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Beauté des mains · La Valentine</p>

          <h1>
            Onglerie
            <span>à La Valentine</span>
          </h1>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="hero-intro">
            Des ongles soignés, naturels ou plus travaillés selon vos envies :
            semi-permanent, gel, comblage et mise en beauté des mains.
          </p>

          <p class="hero-types">
            Semi-permanent · Gel · Comblage · Beauté des mains
          </p>

          <a class="hero-button" href="/reservation/">
            Voir les tarifs & réserver
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <figure
          class="hero-visual"
          data-reveal="image"
          style="--reveal-delay: 90ms"
        >
          <Image
            src={onglerieImage}
            alt="Onglerie à La Valentine chez Appart & Beauté"
            class="hero-photo"
            loading="eager"
            fetchpriority="high"
            widths={[520, 720, 960, 1200]}
            sizes="(min-width: 1000px) 46vw, 100vw"
          />

          <figcaption>Des mains soignées jusque dans les détails.</figcaption>
        </figure>
      </div>
    </section>

    <!-- =====================================================
         PRESTATIONS
         ===================================================== -->
    <section class="services-section">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">Les prestations</p>

          <h2>
            Choisissez
            <span>votre mise en beauté</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="section-intro">
            Marjorie propose plusieurs prestations pour les mains et les pieds,
            avec une finition adaptée au résultat recherché.
          </p>
        </header>

        <div class="services-grid">
          <article
            class="service-card"
            data-reveal
            style="--reveal-delay: 50ms"
          >
            <p class="service-kicker">Mains & pieds</p>
            <h3>Vernis semi-permanent</h3>
            <p>
              Une finition nette et brillante pour les mains ou les pieds, avec
              dépose possible lors du rendez-vous suivant.
            </p>
          </article>

          <article
            class="service-card"
            data-reveal
            style="--reveal-delay: 100ms"
          >
            <p class="service-kicker">Structure & tenue</p>
            <h3>Ongles en gel</h3>
            <p>
              Pose sur ongles naturels ou avec capsules selon le besoin et le
              résultat souhaité.
            </p>
          </article>

          <article
            class="service-card"
            data-reveal
            style="--reveal-delay: 150ms"
          >
            <p class="service-kicker">Entretien</p>
            <h3>Comblage</h3>
            <p>
              L’entretien de votre pose gel pour retrouver une finition
              harmonieuse au fil de la repousse.
            </p>
          </article>

          <article
            class="service-card"
            data-reveal
            style="--reveal-delay: 200ms"
          >
            <p class="service-kicker">Soin essentiel</p>
            <h3>Beauté des mains</h3>
            <p>
              Travail des cuticules et limage pour des mains simplement
              soignées, même sans pose de couleur.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
         FINITIONS
         ===================================================== -->
    <!-- =====================================================
         TENUE & ENTRETIEN
         ===================================================== -->
    <section class="care-section">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">Tenue & entretien</p>

          <h2>
            Garder de beaux ongles
            <span>plus longtemps</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="section-intro">
            La tenue dépend notamment de la pousse de l’ongle et des gestes du
            quotidien. Ces durées sont donc données à titre indicatif.
          </p>
        </header>

        <div class="care-grid">
          <article class="care-card" data-reveal style="--reveal-delay: 70ms">
            <p class="care-value">Environ 2 à 3 semaines</p>
            <h3>Semi-permanent sur les mains</h3>
            <p>
              Le vernis semi-permanent conserve généralement sa brillance et sa
              couleur pendant plusieurs semaines. Sur les pieds, la tenue peut
              être plus longue car les ongles sont moins sollicités.
            </p>
          </article>

          <article class="care-card" data-reveal style="--reveal-delay: 130ms">
            <p class="care-value">Environ 3 à 4 semaines</p>
            <h3>Entretien du gel</h3>
            <p>
              Un comblage permet d’accompagner la repousse de l’ongle et de
              conserver une forme harmonieuse sans refaire systématiquement une
              pose complète.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
         BIEN CHOISIR
         ===================================================== -->
    <section class="choice-section">
      <div class="container choice-grid">
        <div class="choice-copy" data-reveal>
          <p class="eyebrow">Bien choisir</p>

          <h2>
            Semi-permanent
            <span>ou gel ?</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p>
            Le semi-permanent convient particulièrement lorsqu’on souhaite une
            couleur durable sur l’ongle naturel. Le gel permet davantage de
            travailler la structure de l’ongle et, selon la prestation choisie,
            sa longueur.
          </p>
        </div>

        <div class="finish-card" data-reveal style="--reveal-delay: 100ms">
          <p class="panel-kicker">Finitions</p>

          <h3>French & dépose</h3>

          <p>
            Une French peut être ajoutée à certaines prestations. La dépose du
            semi-permanent ou du gel est également proposée à l’institut.
          </p>

          <a class="text-link" href="/reservation/">
            Voir les prestations disponibles
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="local-section">
      <div class="container local-card" data-reveal>
        <div>
          <p class="eyebrow">Marseille 11e</p>

          <h2>
            Votre onglerie
            <span>à La Valentine</span>
          </h2>
        </div>

        <div class="local-copy">
          <p>
            Appart & Beauté vous accueille au 17 rue de l’Audience, à Marseille
            11e, pour vos prestations d’onglerie dans une atmosphère douce et
            intimiste.
          </p>

          <p>
            Les disponibilités et tarifs à jour sont consultables directement
            dans la rubrique Tarifs.
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         CTA
         ===================================================== -->
    <section class="booking-section">
      <div class="container">
        <div class="booking-card" data-reveal>
          <div>
            <p class="eyebrow">Votre prochain rendez-vous</p>

            <h2>
              Envie de
              <span>prendre soin de vos ongles ?</span>
            </h2>

            <p>
              Consultez les tarifs et choisissez le créneau qui vous convient
              directement en ligne.
            </p>
          </div>

          <a class="booking-button" href="/reservation/">
            Voir les tarifs & réserver
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* =====================================================
     COMMUN
     ===================================================== */

  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 19px;
    background: var(--color-terracotta);
  }

  .section-heading h2,
  .details-copy h2,
  .local-card h2,
  .booking-card h2 {
    margin-top: 9px;
    font-size: clamp(2.75rem, 11vw, 3.95rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .section-heading h2 span,
  .details-copy h2 span,
  .local-card h2 span,
  .booking-card h2 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  /* =====================================================
     HERO
     ===================================================== */

  .service-hero {
    padding: 122px 0 58px;
    background: var(--color-bg-soft);
  }

  .hero-grid {
    display: grid;
    gap: 34px;
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero-copy h1 {
    margin-top: 10px;
    font-size: clamp(3.2rem, 13vw, 4.5rem);
    line-height: 0.93;
    letter-spacing: -0.03em;
  }

  .hero-copy h1 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .hero-intro {
    max-width: 580px;
    margin-top: 23px;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .hero-types {
    margin-top: 19px;
    color: var(--color-terracotta-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .hero-button,
  .booking-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    padding: 13px 21px;
    border-radius: 999px;
    background: var(--color-terracotta-dark);
    color: white;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .hero-button {
    margin-top: 25px;
  }

  .hero-button:hover,
  .booking-button:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-2px);
  }

  .hero-visual {
    position: relative;
    width: calc(100% - 22px);
    height: 420px;
    margin-left: auto;
    overflow: hidden;
    border-radius: 108px 26px 26px 26px;
    background: var(--color-beige);
    box-shadow: var(--shadow-soft);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-visual figcaption {
    position: absolute;
    right: 15px;
    bottom: 15px;
    max-width: 220px;
    padding: 12px 15px;
    border-radius: 18px;
    background: rgba(255, 253, 251, 0.93);
    color: var(--color-terracotta-dark);
    font-family: var(--font-title);
    font-size: 1.02rem;
    font-style: italic;
    line-height: 1.2;
    box-shadow: 0 12px 32px rgba(89, 54, 39, 0.09);
    backdrop-filter: blur(6px);
  }

  /* =====================================================
     PRESTATIONS
     ===================================================== */

  .services-section {
    padding: 60px 0 72px;
    background: var(--color-bg-warm);
  }

  .section-heading {
    max-width: 680px;
  }

  .section-intro {
    max-width: 590px;
    margin-top: 20px;
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .services-grid {
    display: grid;
    gap: 15px;
    margin-top: 38px;
  }

  .service-card {
    padding: 27px 23px 26px;
    border: 1px solid rgba(159, 83, 61, 0.08);
    border-radius: 26px;
    background: rgba(255, 253, 251, 0.72);
    box-shadow: 0 10px 30px rgba(73, 48, 39, 0.04);
  }

  .service-kicker,
  .panel-kicker {
    color: var(--color-terracotta-dark);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .service-card h3 {
    margin-top: 8px;
    font-size: 2.15rem;
    line-height: 1.02;
  }

  .service-card > p:last-child {
    margin-top: 14px;
    font-size: 0.91rem;
    line-height: 1.62;
  }

  /* =====================================================
     TENUE & ENTRETIEN
     ===================================================== */

  .care-section {
    padding: 64px 0 74px;
    background: var(--color-bg-soft);
  }

  .care-grid {
    display: grid;
    gap: 15px;
    margin-top: 38px;
  }

  .care-card {
    padding: 28px 23px;
    border-radius: 28px;
    background: rgba(255, 253, 251, 0.82);
    box-shadow: 0 10px 30px rgba(73, 48, 39, 0.045);
  }

  .care-value {
    color: var(--color-terracotta);
    font-family: var(--font-title);
    font-size: 2rem;
    font-style: italic;
    line-height: 1;
  }

  .care-card h3 {
    margin-top: 12px;
    font-size: 1.55rem;
    line-height: 1.1;
  }

  .care-card p:last-child {
    margin-top: 11px;
    font-size: 0.91rem;
    line-height: 1.65;
  }

  /* =====================================================
     BIEN CHOISIR
     ===================================================== */

  .choice-section {
    padding: 64px 0 74px;
    background: var(--color-bg-warm);
  }

  .choice-grid {
    display: grid;
    gap: 30px;
  }

  .choice-copy {
    max-width: 620px;
  }

  .choice-copy h2 {
    margin-top: 9px;
    font-size: clamp(2.75rem, 11vw, 3.95rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .choice-copy h2 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .choice-copy > p:not(.eyebrow) {
    max-width: 560px;
    margin-top: 21px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .finish-card {
    padding: 29px 24px;
    border-radius: 30px;
    background: var(--color-text);
    color: white;
    box-shadow: var(--shadow-soft);
  }

  .panel-kicker {
    color: var(--color-terracotta-light);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .finish-card h3 {
    margin-top: 8px;
    color: white;
    font-size: 2.25rem;
    line-height: 1.05;
  }

  .finish-card > p:not(.panel-kicker) {
    margin-top: 14px;
    color: rgba(255, 253, 251, 0.8);
    font-size: 0.91rem;
    line-height: 1.65;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 23px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(223, 170, 150, 0.5);
    color: var(--color-terracotta-light);
    font-size: 0.83rem;
    font-weight: 500;
  }

  .text-link span {
    transition: transform 0.25s ease;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  /* =====================================================
     LOCAL
     ===================================================== */

  .local-section {
    padding: 64px 0;
    background: var(--color-bg-warm);
  }

  .local-card {
    display: grid;
    gap: 25px;
    padding: 31px 25px;
    border: 1px solid rgba(159, 83, 61, 0.08);
    border-radius: 32px;
    background: rgba(255, 253, 251, 0.66);
  }

  .local-copy {
    display: grid;
    gap: 12px;
  }

  .local-copy p {
    font-size: 0.92rem;
    line-height: 1.68;
  }

  /* =====================================================
     CTA
     ===================================================== */

  .booking-section {
    padding: 8px 0 76px;
    background: var(--color-bg-warm);
  }

  .booking-card {
    display: grid;
    gap: 27px;
    padding: 34px 25px;
    border-radius: 32px;
    background: #f3e6dc;
    box-shadow: var(--shadow-card);
  }

  .booking-card > div > p:last-child {
    max-width: 560px;
    margin-top: 17px;
    font-size: 0.93rem;
    line-height: 1.65;
  }

  .booking-button {
    width: 100%;
  }

  /* =====================================================
     PETITS MOBILES
     ===================================================== */

  @media (max-width: 390px) {
    .service-hero {
      padding-top: 114px;
    }

    .hero-copy h1 {
      font-size: 3rem;
    }

    .hero-visual {
      height: 385px;
    }

    .service-card h3 {
      font-size: 1.95rem;
    }
  }

  /* =====================================================
     TABLETTE
     ===================================================== */

  @media (min-width: 700px) {
    .service-hero {
      padding: 145px 0 76px;
    }

    .hero-copy h1 {
      font-size: 5.2rem;
    }

    .hero-visual {
      max-width: 720px;
      height: 560px;
    }

    .services-section,
    .care-section,
    .choice-section,
    .local-section {
      padding-top: 82px;
      padding-bottom: 90px;
    }

    .section-heading h2,
    .choice-copy h2,
    .local-card h2,
    .booking-card h2 {
      font-size: 4.5rem;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .care-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .choice-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 55px;
    }

    .local-card {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 50px;
      padding: 42px 38px;
    }

    .booking-card {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 45px;
      padding: 42px 38px;
    }

    .booking-button {
      width: 285px;
    }
  }

  /* =====================================================
     DESKTOP
     ===================================================== */

  @media (min-width: 1000px) {
    .service-hero {
      padding: 150px 0 92px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      align-items: center;
      gap: 75px;
    }

    .hero-copy h1 {
      font-size: clamp(4.5rem, 5.4vw, 6.15rem);
    }

    .hero-visual {
      width: 100%;
      height: 610px;
      margin-left: 0;
      border-radius: 155px 32px 32px 32px;
    }

    .hero-visual figcaption {
      right: 22px;
      bottom: 22px;
      max-width: 255px;
      padding: 16px 19px;
      border-radius: 22px;
      font-size: 1.2rem;
    }

    .services-section,
    .care-section,
    .choice-section,
    .local-section {
      padding-top: 94px;
      padding-bottom: 102px;
    }

    .section-heading {
      display: grid;
      max-width: none;
      grid-template-columns: 1fr 0.78fr;
      grid-template-areas:
        "eyebrow eyebrow"
        "title intro"
        "line intro";
      column-gap: 78px;
      align-items: end;
    }

    .section-heading .eyebrow {
      grid-area: eyebrow;
    }

    .section-heading h2 {
      grid-area: title;
      font-size: 5.2rem;
    }

    .section-heading .heading-line {
      grid-area: line;
    }

    .section-intro {
      grid-area: intro;
      margin-top: 0;
      padding-bottom: 4px;
    }

    .services-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-top: 52px;
    }

    .service-card {
      min-height: 280px;
      padding: 30px 25px;
    }

    .service-card h3 {
      font-size: 2.3rem;
    }

    .choice-grid {
      gap: 85px;
    }

    .choice-copy h2,
    .local-card h2,
    .booking-card h2 {
      font-size: 4.8rem;
    }

    .finish-card {
      padding: 36px 32px;
      border-radius: 36px;
    }

    .local-card {
      gap: 80px;
      padding: 50px 48px;
      border-radius: 38px;
    }

    .booking-section {
      padding: 8px 0 92px;
    }

    .booking-card {
      gap: 70px;
      padding: 48px 48px;
      border-radius: 38px;
    }
  }
</style>
