---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import epilationImage from "../assets/images/prestations/prestation-epilation.webp";
---

<BaseLayout
  title="Épilation La Valentine Marseille 11e | Appart & Beauté"
  description="Épilation femme et homme à La Valentine, Marseille 11e : visage, aisselles, maillot, jambes, bras, dos, torse et forfaits chez Appart & Beauté."
>
  <Header />

  <main>
    <!-- =====================================================
         HERO
         ===================================================== -->
    <section class="service-hero">
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Épilation · La Valentine</p>

          <h1>
            Épilation
            <span>à Marseille 11e</span>
          </h1>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="hero-intro">
            Des prestations d’épilation pour le visage et le corps, pour femme
            et homme, réalisées avec précision dans l’atmosphère douce et
            intimiste d’Appart & Beauté.
          </p>

          <p class="hero-types">Femme · Homme · Visage · Corps · Forfaits</p>

          <a class="hero-button" href="/reservation/">
            Voir les tarifs & réserver
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <figure
          class="hero-visual"
          data-reveal="image"
          style="--reveal-delay: 90ms"
        >
          <Image
            src={epilationImage}
            alt="Épilation à La Valentine Marseille 11e chez Appart & Beauté"
            class="hero-photo"
            loading="eager"
            fetchpriority="high"
            widths={[520, 720, 960, 1200]}
            sizes="(min-width: 1000px) 46vw, 100vw"
          />

          <figcaption>
            Une peau nette, avec une prestation adaptée à la zone.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- =====================================================
         FEMME
         ===================================================== -->
    <section class="women-section">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">Épilation femme</p>

          <h2>
            Visage, corps
            <span>& forfaits</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="section-intro">
            Les prestations sont proposées à la zone ou sous forme de forfaits
            pour regrouper plusieurs épilations au cours d’un même rendez-vous.
          </p>
        </header>

        <div class="zone-grid">
          <article class="zone-card" data-reveal style="--reveal-delay: 60ms">
            <p class="zone-kicker">Corps</p>
            <h3>Les zones proposées</h3>

            <div class="chips">
              <span>Aisselles</span>
              <span>Maillot simple ou échancré</span>
              <span>Maillot intégral ou brésilien</span>
              <span>1/2 jambes</span>
              <span>Cuisses</span>
              <span>Jambes entières</span>
              <span>1/2 bras</span>
              <span>Bras</span>
            </div>
          </article>

          <article class="zone-card" data-reveal style="--reveal-delay: 120ms">
            <p class="zone-kicker">Visage</p>
            <h3>Une prestation ciblée</h3>

            <div class="chips">
              <span>Sourcils</span>
              <span>Lèvre</span>
              <span>Menton</span>
              <span>Joues</span>
              <span>Nez</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
         FORFAITS
         ===================================================== -->
    <section class="packages-section">
      <div class="container packages-grid">
        <div class="packages-copy" data-reveal>
          <p class="eyebrow">Gagner du temps</p>

          <h2>
            Des forfaits
            <span>pour plusieurs zones</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p>
            Pour les rendez-vous qui regroupent plusieurs zones, Appart & Beauté
            propose aussi des forfaits associant les aisselles, le maillot et
            les jambes ou les cuisses.
          </p>

          <a class="text-link" href="/reservation/">
            Consulter les forfaits et les tarifs
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="packages-panel" data-reveal style="--reveal-delay: 100ms">
          <p class="panel-kicker">Exemples de combinaisons</p>

          <div class="package-line">
            <span>01</span>
            <p>Aisselles + maillot + 1/2 jambes</p>
          </div>

          <div class="package-line">
            <span>02</span>
            <p>Aisselles + maillot + cuisses</p>
          </div>

          <div class="package-line">
            <span>03</span>
            <p>Aisselles + maillot + jambes entières</p>
          </div>

          <p class="panel-note">
            Plusieurs variantes sont disponibles selon le type de maillot
            choisi.
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         HOMME
         ===================================================== -->
    <section class="men-section">
      <div class="container men-card" data-reveal>
        <div>
          <p class="eyebrow">Épilation homme</p>

          <h2>
            Des prestations
            <span>aussi pour les hommes</span>
          </h2>

          <p>
            Appart & Beauté propose également plusieurs zones visage et corps
            pour homme, ainsi qu’un forfait dos + torse.
          </p>
        </div>

        <div class="men-zones">
          <div>
            <p class="men-label">Visage</p>
            <p>Sourcils · Joues · Nez ou oreilles</p>
          </div>

          <div>
            <p class="men-label">Corps</p>
            <p>Dos · Torse · Épaules · Jambes entières · Bras · Aisselles</p>
          </div>

          <div>
            <p class="men-label">Forfait</p>
            <p>Dos + torse</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         LOCAL / SEO
         ===================================================== -->
    <section class="local-section">
      <div class="container local-card" data-reveal>
        <div>
          <p class="eyebrow">La Valentine · Marseille 11e</p>

          <h2>
            Votre institut
            <span>pour l’épilation</span>
          </h2>
        </div>

        <div class="local-copy">
          <p>
            Marjorie vous accueille au 17 rue de l’Audience, à La Valentine,
            Marseille 11e, pour vos rendez-vous d’épilation femme et homme.
          </p>

          <p>
            Pour garder des informations toujours à jour, les tarifs, durées et
            créneaux disponibles sont consultables directement dans la rubrique
            Tarifs.
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         CTA
         ===================================================== -->
    <section class="booking-section">
      <div class="container">
        <div class="booking-card" data-reveal>
          <div>
            <p class="eyebrow">Votre rendez-vous</p>

            <h2>
              Choisissez votre
              <span>prestation d’épilation</span>
            </h2>

            <p>
              Retrouvez toutes les zones, les forfaits, les tarifs et les
              disponibilités dans la rubrique Tarifs.
            </p>
          </div>

          <a class="booking-button" href="/reservation/">
            Voir les tarifs & réserver
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* =====================================================
     COMMUN
     ===================================================== */

  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 19px;
    background: var(--color-terracotta);
  }

  .section-heading h2,
  .packages-copy h2,
  .men-card h2,
  .local-card h2,
  .booking-card h2 {
    margin-top: 9px;
    font-size: clamp(2.75rem, 11vw, 3.95rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .section-heading h2 span,
  .packages-copy h2 span,
  .men-card h2 span,
  .local-card h2 span,
  .booking-card h2 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  /* =====================================================
     HERO
     ===================================================== */

  .service-hero {
    padding: 122px 0 58px;
    background: var(--color-bg-soft);
  }

  .hero-grid {
    display: grid;
    gap: 34px;
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero-copy h1 {
    margin-top: 10px;
    font-size: clamp(3.2rem, 13vw, 4.5rem);
    line-height: 0.93;
    letter-spacing: -0.03em;
  }

  .hero-copy h1 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .hero-intro {
    max-width: 590px;
    margin-top: 23px;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .hero-types {
    margin-top: 19px;
    color: var(--color-terracotta-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .hero-button,
  .booking-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    padding: 13px 21px;
    border-radius: 999px;
    background: var(--color-terracotta-dark);
    color: white;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .hero-button {
    margin-top: 25px;
  }

  .hero-button:hover,
  .booking-button:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-2px);
  }

  .hero-visual {
    position: relative;
    width: calc(100% - 22px);
    height: 420px;
    margin-left: auto;
    overflow: hidden;
    border-radius: 108px 26px 26px 26px;
    background: var(--color-beige);
    box-shadow: var(--shadow-soft);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-visual figcaption {
    position: absolute;
    right: 15px;
    bottom: 15px;
    max-width: 235px;
    padding: 12px 15px;
    border-radius: 18px;
    background: rgba(255, 253, 251, 0.93);
    color: var(--color-terracotta-dark);
    font-family: var(--font-title);
    font-size: 1.02rem;
    font-style: italic;
    line-height: 1.2;
    box-shadow: 0 12px 32px rgba(89, 54, 39, 0.09);
    backdrop-filter: blur(6px);
  }

  /* =====================================================
     FEMME
     ===================================================== */

  .women-section {
    padding: 60px 0 74px;
    background: var(--color-bg-warm);
  }

  .section-heading {
    max-width: 680px;
  }

  .section-intro {
    max-width: 590px;
    margin-top: 20px;
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .zone-grid {
    display: grid;
    gap: 16px;
    margin-top: 38px;
  }

  .zone-card {
    padding: 27px 23px 28px;
    border: 1px solid rgba(159, 83, 61, 0.08);
    border-radius: 28px;
    background: rgba(255, 253, 251, 0.72);
    box-shadow: 0 10px 30px rgba(73, 48, 39, 0.04);
  }

  .zone-kicker,
  .panel-kicker,
  .men-label {
    color: var(--color-terracotta-dark);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .zone-card h3 {
    margin-top: 8px;
    font-size: 2.15rem;
    line-height: 1.02;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .chips span {
    padding: 8px 11px;
    border: 1px solid rgba(159, 83, 61, 0.12);
    border-radius: 999px;
    background: rgba(241, 225, 213, 0.55);
    color: var(--color-text-soft);
    font-size: 0.75rem;
  }

  /* =====================================================
     FORFAITS
     ===================================================== */

  .packages-section {
    padding: 64px 0 74px;
    background: var(--color-bg-soft);
  }

  .packages-grid {
    display: grid;
    gap: 34px;
  }

  .packages-copy {
    max-width: 620px;
  }

  .packages-copy > p:not(.eyebrow) {
    max-width: 560px;
    margin-top: 21px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 23px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(159, 83, 61, 0.3);
    color: var(--color-terracotta-dark);
    font-size: 0.83rem;
    font-weight: 500;
  }

  .text-link span {
    transition: transform 0.25s ease;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  .packages-panel {
    padding: 28px 23px;
    border-radius: 30px;
    background: var(--color-text);
    color: white;
    box-shadow: var(--shadow-soft);
  }

  .packages-panel .panel-kicker {
    color: var(--color-terracotta-light);
  }

  .package-line {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .package-line span {
    color: var(--color-terracotta-light);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .package-line p,
  .panel-note {
    color: rgba(255, 253, 251, 0.84);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .panel-note {
    margin-top: 18px;
    color: rgba(255, 253, 251, 0.62);
  }

  /* =====================================================
     HOMME
     ===================================================== */

  .men-section {
    padding: 64px 0 74px;
    background: var(--color-bg-warm);
  }

  .men-card {
    display: grid;
    gap: 30px;
    padding: 31px 25px;
    border: 1px solid rgba(159, 83, 61, 0.08);
    border-radius: 32px;
    background: rgba(255, 253, 251, 0.68);
  }

  .men-card > div:first-child > p:last-child {
    max-width: 560px;
    margin-top: 18px;
    font-size: 0.94rem;
    line-height: 1.68;
  }

  .men-zones {
    display: grid;
    gap: 13px;
  }

  .men-zones > div {
    padding: 18px 19px;
    border-radius: 20px;
    background: var(--color-bg-soft);
  }

  .men-zones > div > p:last-child {
    margin-top: 7px;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* =====================================================
     LOCAL
     ===================================================== */

  .local-section {
    padding: 64px 0;
    background: var(--color-bg-soft);
  }

  .local-card {
    display: grid;
    gap: 25px;
    padding: 31px 25px;
    border: 1px solid rgba(159, 83, 61, 0.08);
    border-radius: 32px;
    background: rgba(255, 253, 251, 0.72);
  }

  .local-copy {
    display: grid;
    gap: 12px;
  }

  .local-copy p {
    font-size: 0.92rem;
    line-height: 1.68;
  }

  /* =====================================================
     CTA
     ===================================================== */

  .booking-section {
    padding: 8px 0 76px;
    background: var(--color-bg-soft);
  }

  .booking-card {
    display: grid;
    gap: 27px;
    padding: 34px 25px;
    border-radius: 32px;
    background: #f3e6dc;
    box-shadow: var(--shadow-card);
  }

  .booking-card > div > p:last-child {
    max-width: 560px;
    margin-top: 17px;
    font-size: 0.93rem;
    line-height: 1.65;
  }

  .booking-button {
    width: 100%;
  }

  /* =====================================================
     PETITS MOBILES
     ===================================================== */

  @media (max-width: 390px) {
    .service-hero {
      padding-top: 114px;
    }

    .hero-copy h1 {
      font-size: 3rem;
    }

    .hero-visual {
      height: 385px;
    }

    .zone-card h3 {
      font-size: 1.95rem;
    }
  }

  /* =====================================================
     TABLETTE
     ===================================================== */

  @media (min-width: 700px) {
    .service-hero {
      padding: 145px 0 76px;
    }

    .hero-copy h1 {
      font-size: 5.2rem;
    }

    .hero-visual {
      max-width: 720px;
      height: 560px;
    }

    .women-section,
    .packages-section,
    .men-section,
    .local-section {
      padding-top: 82px;
      padding-bottom: 90px;
    }

    .section-heading h2,
    .packages-copy h2,
    .men-card h2,
    .local-card h2,
    .booking-card h2 {
      font-size: 4.5rem;
    }

    .zone-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .packages-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 55px;
    }

    .men-card,
    .local-card {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 50px;
      padding: 42px 38px;
    }

    .booking-card {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 45px;
      padding: 42px 38px;
    }

    .booking-button {
      width: 285px;
    }
  }

  /* =====================================================
     DESKTOP
     ===================================================== */

  @media (min-width: 1000px) {
    .service-hero {
      padding: 150px 0 92px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      align-items: center;
      gap: 75px;
    }

    .hero-copy h1 {
      font-size: clamp(4.5rem, 5.4vw, 6.15rem);
    }

    .hero-visual {
      width: 100%;
      height: 610px;
      margin-left: 0;
      border-radius: 155px 32px 32px 32px;
    }

    .hero-visual figcaption {
      right: 22px;
      bottom: 22px;
      max-width: 260px;
      padding: 16px 19px;
      border-radius: 22px;
      font-size: 1.2rem;
    }

    .women-section,
    .packages-section,
    .men-section,
    .local-section {
      padding-top: 94px;
      padding-bottom: 102px;
    }

    .section-heading {
      display: grid;
      max-width: none;
      grid-template-columns: 1fr 0.78fr;
      grid-template-areas:
        "eyebrow eyebrow"
        "title intro"
        "line intro";
      column-gap: 78px;
      align-items: end;
    }

    .section-heading .eyebrow {
      grid-area: eyebrow;
    }

    .section-heading h2 {
      grid-area: title;
      font-size: 5.2rem;
    }

    .section-heading .heading-line {
      grid-area: line;
    }

    .section-intro {
      grid-area: intro;
      margin-top: 0;
      padding-bottom: 4px;
    }

    .zone-grid {
      gap: 20px;
      margin-top: 52px;
    }

    .zone-card {
      padding: 32px 28px;
    }

    .zone-card h3 {
      font-size: 2.55rem;
    }

    .packages-grid {
      gap: 85px;
    }

    .packages-copy h2,
    .men-card h2,
    .local-card h2,
    .booking-card h2 {
      font-size: 4.8rem;
    }

    .packages-panel {
      padding: 36px 32px;
      border-radius: 36px;
    }

    .men-card,
    .local-card {
      gap: 80px;
      padding: 50px 48px;
      border-radius: 38px;
    }

    .booking-section {
      padding: 8px 0 92px;
    }

    .booking-card {
      gap: 70px;
      padding: 48px;
      border-radius: 38px;
    }
  }
</style>
