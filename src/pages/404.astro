---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Page introuvable | Appart & Beauté Institut"
  description="La page que vous recherchez n’existe pas ou a été déplacée."
  robots="noindex, follow"
>
  <Header />

  <main>
    <section class="error-page">
      <div class="container error-inner">
        <p class="error-code">404</p>

        <h1>
          Oups, cette page
          <span>n’existe pas</span>
        </h1>

        <span class="heading-line" aria-hidden="true"></span>

        <p class="error-text">
          La page que vous recherchez a peut-être été déplacée ou n’est plus disponible.
          Vous pouvez revenir à l’accueil ou découvrir les prestations de l’institut.
        </p>

        <div class="error-actions">
          <a class="primary-button" href="/">
            Retour à l’accueil
            <span aria-hidden="true">→</span>
          </a>

          <a class="secondary-link" href="/prestations/">
            Voir les prestations
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .error-page {
    min-height: 76vh;
    display: flex;
    align-items: center;
    padding: 140px 0 90px;
    background: var(--color-bg-soft);
  }

  .error-inner {
    max-width: 760px;
  }

  .error-code {
    margin: 0;
    color: var(--color-terracotta-dark);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(3.2rem, 12vw, 5.8rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  h1 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .heading-line {
    display: block;
    width: 58px;
    height: 2px;
    margin-top: 22px;
    background: var(--color-terracotta);
  }

  .error-text {
    max-width: 620px;
    margin-top: 24px;
    color: var(--color-text-soft);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .error-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin-top: 30px;
  }

  .primary-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 13px 21px;
    border-radius: 999px;
    background: var(--color-terracotta-dark);
    color: #fff;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .secondary-link {
    color: var(--color-terracotta-dark);
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 700px) {
    .error-page {
      padding: 170px 0 120px;
    }

    .error-actions {
      flex-direction: row;
      align-items: center;
      gap: 28px;
    }
  }
</style>