---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PlanityBookingCompact from "../components/PlanityBooking-compact.astro";

import extensionsImage from "../assets/images/prestations/prestation-extensions.webp";
import regardImage from "../assets/images/regard/prestation-extension.webp";

const extensionServices = [
  "-O3Ha0NF1KuoZiP2Vm3J", // Cil à cil — pose complète
  "-O3Ha1bvz8983Xd_UzZh", // Cil à cil — remplissage
  "-O3Ha8t_xqpQgqyw2HII", // Hybride — pose complète
  "-O3Ha91IgWSExNZmHra_", // Hybride — remplissage
  "-O3HaKMxavyVpelnwUA2", // Volume russe — pose complète
  "-O3HaKYSc7Wn1JQs4ToA", // Volume russe — remplissage
];
---

<BaseLayout
  title="Extensions de cils Marseille 11e | Appart & Beauté"
  description="Extensions de cils à La Valentine, Marseille 11e : cil à cil, pose hybride et volume russe chez Appart & Beauté. Réservation en ligne avec Marjorie."
>
  <Header />

  <main>
    <!-- =====================================================
         HERO
         ===================================================== -->
    <section class="service-hero">
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Beauté du regard · La Valentine</p>

          <h1>
            Extensions de cils
            <span>à Marseille</span>
          </h1>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="hero-intro">
            Du cil à cil au volume russe, une pose adaptée au résultat que vous
            recherchez : naturel, plus structuré ou plus intense.
          </p>

          <p class="hero-types">Cil à cil · Hybride · Volume russe</p>

          <a class="hero-button" href="#reservation-extensions">
            Voir les rendez-vous
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <figure
          class="hero-visual"
          data-reveal="image"
          style="--reveal-delay: 90ms"
        >
          <Image
            src={extensionsImage}
            alt="Extensions de cils à Marseille chez Appart & Beauté"
            class="hero-photo"
            widths={[520, 720, 960, 1200]}
            sizes="(min-width: 1000px) 46vw, 100vw"
          />

          <figcaption>Un regard intensifié, selon votre style.</figcaption>
        </figure>
      </div>
    </section>

    <!-- =====================================================
         PRINCIPE / TYPES DE POSE
         ===================================================== -->
    <section class="about-section">
      <div class="container">
        <header class="section-heading" data-reveal>
          <p class="eyebrow">Choisir son effet</p>

          <h2>
            Une pose pensée
            <span>pour votre regard</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p class="section-intro">
            Marjorie propose trois styles d’extensions pour moduler l’intensité
            du regard, du rendu le plus discret au plus soutenu.
          </p>
        </header>

        <div class="style-grid">
          <article class="style-card" data-reveal style="--reveal-delay: 70ms">
            <p class="style-label">Effet naturel</p>
            <h3>Cil à cil</h3>
            <p>
              Une pose légère pour souligner la ligne des cils tout en gardant
              un résultat naturel et élégant.
            </p>
          </article>

          <article class="style-card" data-reveal style="--reveal-delay: 140ms">
            <p class="style-label">Effet intermédiaire</p>
            <h3>Hybride</h3>
            <p>
              Un compromis entre naturel et volume pour un regard davantage
              dessiné sans aller vers un résultat très dense.
            </p>
          </article>

          <article class="style-card" data-reveal style="--reveal-delay: 210ms">
            <p class="style-label">Effet intense</p>
            <h3>Volume russe</h3>
            <p>
              Une pose plus fournie pour celles qui souhaitent intensifier
              davantage le regard et obtenir un résultat plus marqué.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- =====================================================
         DÉROULÉ
         ===================================================== -->
    <section class="process-section">
      <div class="container process-grid">
        <figure class="process-visual" data-reveal="image">
          <Image
            src={regardImage}
            alt="Mise en beauté du regard chez Appart & Beauté à La Valentine"
            class="process-photo"
            widths={[520, 720, 960]}
            sizes="(min-width: 1000px) 43vw, 100vw"
            loading="lazy"
          />
        </figure>

        <div class="process-copy" data-reveal style="--reveal-delay: 100ms">
          <p class="eyebrow">Votre rendez-vous</p>

          <h2>
            Un résultat
            <span>adapté à vos envies</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <div class="steps">
            <div class="step">
              <div>
                <h3>Choisir</h3>
                <p>
                  Naturel, hybride ou plus intense : le rendu recherché permet
                  d’orienter le choix de la pose.
                </p>
              </div>
            </div>

            <div class="step">
              <div>
                <h3>Poser</h3>
                <p>
                  La pose est réalisée avec précision pour construire une ligne
                  harmonieuse et mettre en valeur le regard.
                </p>
              </div>
            </div>

            <div class="step">
              <div>
                <h3>Entretenir</h3>
                <p>
                  Des prestations de remplissage sont également proposées pour
                  entretenir votre pose au fil des rendez-vous.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================
         EN PRATIQUE
         ===================================================== -->
    <section class="practice-section">
      <div class="container">
        <header class="section-heading practice-heading" data-reveal>
          <p class="eyebrow">En pratique</p>

          <h2>
            Quelques
            <span>repères</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>
        </header>

        <div class="practice-grid">
          <article
            class="practice-card"
            data-reveal
            style="--reveal-delay: 70ms"
          >
            <span class="practice-value">1 h 45 à 2 h</span>
            <h3>Pose complète</h3>
            <p>
              La durée varie selon la technique choisie : cil à cil, hybride ou
              volume russe.
            </p>
          </article>

          <article
            class="practice-card"
            data-reveal
            style="--reveal-delay: 140ms"
          >
            <span class="practice-value">1 h 15 à 1 h 45</span>
            <h3>Remplissage</h3>
            <p>
              Le temps prévu dépend lui aussi de la technique d’extensions
              choisie.
            </p>
          </article>
        </div>

        <div class="advice-card" data-reveal style="--reveal-delay: 190ms">
          <div>
            <p class="advice-kicker">Vous hésitez ?</p>
            <h3>Naturel, hybride ou volume russe ?</h3>
          </div>

          <p>
            Si vous ne savez pas quelle pose choisir, Marjorie pourra vous aider
            à vous orienter vers le résultat qui correspond le mieux à vos
            envies.
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         RÉSERVATION PLANITY
         ===================================================== -->
    <section class="booking-section" id="reservation-extensions">
      <div class="container booking-container">
        <header class="booking-heading" data-reveal>
          <p class="eyebrow">Réservation</p>

          <h2>
            Choisir votre
            <span>rendez-vous</span>
          </h2>

          <span class="heading-line" aria-hidden="true"></span>

          <p>
            Sélectionnez votre pose ou votre remplissage, puis le créneau qui
            vous convient. Les tarifs affichés dans Planity sont les tarifs à
            jour de l’institut.
          </p>
        </header>

        <div class="booking-card" data-reveal style="--reveal-delay: 90ms">
          <PlanityBookingCompact
            services={extensionServices}
            containerId="planity-extensions"
            displayTitle="Extensions de cils"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* =====================================================
     COMMUN
     ===================================================== */

  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 19px;
    background: var(--color-terracotta);
  }

  .section-heading h2,
  .process-copy h2,
  .booking-heading h2 {
    margin-top: 9px;
    font-size: clamp(2.85rem, 11vw, 3.95rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .section-heading h2 span,
  .process-copy h2 span,
  .booking-heading h2 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  /* =====================================================
     HERO — MOBILE FIRST
     ===================================================== */

  .service-hero {
    padding: 122px 0 58px;
    background: var(--color-bg-soft);
  }

  .hero-grid {
    display: grid;
    gap: 34px;
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero-copy h1 {
    margin-top: 10px;
    font-size: clamp(3.2rem, 13vw, 4.5rem);
    line-height: 0.93;
    letter-spacing: -0.03em;
  }

  .hero-copy h1 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .hero-intro {
    max-width: 580px;
    margin-top: 23px;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .hero-types {
    margin-top: 19px;
    color: var(--color-terracotta-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .hero-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    margin-top: 25px;
    padding: 13px 21px;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: white;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .hero-button:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-2px);
  }

  .hero-button span {
    font-size: 1rem;
  }

  .hero-visual {
    position: relative;
    width: calc(100% - 22px);
    height: 420px;
    margin-left: auto;
    overflow: hidden;
    border-radius: 108px 26px 26px 26px;
    background: var(--color-beige);
    box-shadow: var(--shadow-soft);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .hero-visual figcaption {
    position: absolute;
    right: 15px;
    bottom: 15px;
    max-width: 210px;
    padding: 12px 15px;
    border-radius: 18px;
    background: rgba(255, 253, 251, 0.93);
    color: var(--color-terracotta-dark);
    font-family: var(--font-title);
    font-size: 1.02rem;
    font-style: italic;
    line-height: 1.2;
    box-shadow: 0 12px 32px rgba(89, 54, 39, 0.09);
    backdrop-filter: blur(6px);
  }

  /* =====================================================
     TYPES DE POSE
     ===================================================== */

  .about-section {
    padding: 58px 0 72px;
    background: var(--color-bg-warm);
  }

  .section-heading {
    max-width: 680px;
  }

  .section-intro {
    max-width: 580px;
    margin-top: 20px;
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .style-grid {
    display: grid;
    gap: 15px;
    margin-top: 38px;
  }

  .style-card {
    position: relative;
    overflow: hidden;
    padding: 26px 22px 24px;
    border: 1px solid rgba(159, 83, 61, 0.09);
    border-radius: 26px;
    background: rgba(255, 253, 251, 0.7);
    box-shadow: 0 10px 30px rgba(73, 48, 39, 0.04);
  }

  .style-label {
    margin-top: 0;
    color: var(--color-terracotta-dark);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .style-card h3 {
    margin-top: 7px;
    font-size: 2.35rem;
    line-height: 1;
  }

  .style-card > p:last-child {
    margin-top: 14px;
    font-size: 0.91rem;
    line-height: 1.62;
  }

  /* =====================================================
     DÉROULÉ
     ===================================================== */

  .process-section {
    padding: 64px 0 72px;
    background: var(--color-bg-soft);
  }

  .process-grid {
    display: grid;
    gap: 39px;
  }

  .process-visual {
    width: calc(100% - 28px);
    height: 420px;
    overflow: hidden;
    border-radius: 26px 92px 26px 26px;
    background: var(--color-beige);
    box-shadow: var(--shadow-soft);
  }

  .process-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .process-copy {
    max-width: 620px;
  }

  .steps {
    display: grid;
    gap: 23px;
    margin-top: 34px;
  }

  .step {
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(159, 83, 61, 0.10);
  }

  .step:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .step h3 {
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .step p {
    margin-top: 5px;
    font-size: 0.91rem;
    line-height: 1.6;
  }

  /* =====================================================
     EN PRATIQUE
     ===================================================== */

  .practice-section {
    padding: 62px 0 74px;
    background: var(--color-bg-warm);
  }

  .practice-grid {
    display: grid;
    gap: 15px;
    margin-top: 38px;
  }

  .practice-card {
    padding: 26px 22px;
    border-radius: 26px;
    background: rgba(255, 253, 251, 0.82);
    box-shadow: 0 10px 30px rgba(73, 48, 39, 0.045);
  }

  .practice-value {
    display: block;
    color: var(--color-terracotta);
    font-family: var(--font-title);
    font-size: 2.4rem;
    font-style: italic;
    line-height: 1;
  }

  .practice-card h3 {
    margin-top: 12px;
    font-size: 1.35rem;
  }

  .practice-card p {
    margin-top: 8px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .advice-card {
    display: grid;
    gap: 20px;
    margin-top: 18px;
    padding: 29px 24px;
    border-radius: 30px;
    background: var(--color-text);
    color: var(--color-white);
  }

  .advice-kicker {
    color: var(--color-terracotta-light);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .advice-card h3 {
    max-width: 470px;
    margin-top: 7px;
    color: white;
    font-size: 2rem;
    line-height: 1.05;
  }

  .advice-card > p {
    max-width: 520px;
    color: rgba(255, 253, 251, 0.72);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* =====================================================
     RÉSERVATION
     ===================================================== */

  .booking-section {
    scroll-margin-top: 110px;
    padding: 62px 0 74px;
    background: var(--color-bg-soft);
  }

  .booking-heading {
    max-width: 680px;
  }

  .booking-heading > p:last-child {
    max-width: 590px;
    margin-top: 20px;
    font-size: 0.95rem;
    line-height: 1.68;
  }

  .booking-card {
    margin-top: 34px;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  /* =====================================================
     PETITS MOBILES
     ===================================================== */

  @media (max-width: 390px) {
    .service-hero {
      padding-top: 114px;
    }

    .hero-copy h1 {
      font-size: 3rem;
    }

    .hero-visual,
    .process-visual {
      height: 385px;
    }

    .style-card h3 {
      font-size: 2.15rem;
    }

    .advice-card h3 {
      font-size: 1.8rem;
    }
  }

  /* =====================================================
     TABLETTE
     ===================================================== */

  @media (min-width: 700px) and (max-width: 999px) {
    .service-hero {
      padding: 145px 0 76px;
    }

    .hero-grid {
      gap: 44px;
    }

    .hero-copy h1 {
      font-size: 5.4rem;
    }

    .hero-visual {
      max-width: 720px;
      height: 560px;
    }

    .about-section,
    .process-section,
    .practice-section,
    .booking-section {
      padding-top: 82px;
      padding-bottom: 88px;
    }

    .section-heading h2,
    .process-copy h2,
    .booking-heading h2 {
      font-size: 4.7rem;
    }

    .style-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 17px;
    }

    .process-visual {
      max-width: 720px;
      height: 540px;
    }

    .practice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .advice-card {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: end;
      gap: 45px;
      padding: 38px 34px;
    }
  }

  /* =====================================================
     DESKTOP
     ===================================================== */

  @media (min-width: 1000px) {
    .service-hero {
      padding: 150px 0 92px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      align-items: center;
      gap: 75px;
    }

    .hero-copy h1 {
      font-size: clamp(4.5rem, 5.4vw, 6.15rem);
    }

    .hero-intro {
      font-size: 1rem;
    }

    .hero-visual {
      width: 100%;
      height: 610px;
      margin-left: 0;
      border-radius: 155px 32px 32px 32px;
    }

    .hero-visual figcaption {
      right: 22px;
      bottom: 22px;
      max-width: 245px;
      padding: 16px 19px;
      border-radius: 22px;
      font-size: 1.2rem;
    }

    .about-section,
    .process-section,
    .practice-section,
    .booking-section {
      padding-top: 92px;
      padding-bottom: 100px;
    }

    .section-heading,
    .practice-heading,
    .booking-heading {
      display: grid;
      max-width: none;
      grid-template-columns: 1fr 0.78fr;
      grid-template-areas:
        "eyebrow eyebrow"
        "title intro"
        "line intro";
      column-gap: 78px;
      align-items: end;
    }

    .section-heading .eyebrow,
    .practice-heading .eyebrow,
    .booking-heading .eyebrow {
      grid-area: eyebrow;
    }

    .section-heading h2,
    .practice-heading h2,
    .booking-heading h2 {
      grid-area: title;
      font-size: clamp(4.35rem, 5vw, 5.25rem);
    }

    .section-heading .heading-line,
    .practice-heading .heading-line,
    .booking-heading .heading-line {
      grid-area: line;
      justify-self: start;
    }

    .section-intro,
    .booking-heading > p:last-child {
      grid-area: intro;
      align-self: end;
      margin-top: 0;
      padding-bottom: 6px;
      font-size: 1rem;
    }

    .style-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 48px;
    }

    .style-card {
      min-height: 325px;
      padding: 30px 28px;
      border-radius: 28px;
    }

    .style-card h3 {
      font-size: 2.65rem;
    }

    .process-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      align-items: center;
      gap: 78px;
    }

    .process-visual {
      width: 100%;
      height: 590px;
      border-radius: 32px 150px 32px 32px;
    }

    .process-copy h2 {
      font-size: clamp(4.15rem, 4.8vw, 5.15rem);
    }

    .steps {
      margin-top: 40px;
    }

    .practice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-top: 48px;
    }

    .practice-card {
      min-height: 235px;
      padding: 32px 30px;
      border-radius: 28px;
    }

    .practice-value {
      font-size: 3rem;
    }

    .advice-card {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 80px;
      margin-top: 22px;
      padding: 44px 46px;
      border-radius: 34px;
    }

    .advice-card h3 {
      font-size: 2.5rem;
    }

    .booking-card {
      margin-top: 48px;
    }
  }

  /* =====================================================
     GRAND DESKTOP
     ===================================================== */

  @media (min-width: 1400px) {
    .hero-grid {
      gap: 90px;
    }

    .hero-visual {
      height: 650px;
    }

    .style-grid,
    .practice-grid {
      gap: 22px;
    }
  }
</style>
