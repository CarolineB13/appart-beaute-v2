---
import { Image } from "astro:assets";
import lashLiftImage from "../assets/images/regard/lash-lift-coreen.webp";
---

<section class="lashlift-section">
  <div class="container lashlift-grid">
    <div class="lashlift-visual">
      <div class="image-wrapper">
        <Image
          src={lashLiftImage}
          alt="Résultat Lash Lift Coréen chez Appart & Beauté à Marseille"
        />

        <span class="badge"> Nouveauté </span>
      </div>

      <p class="visual-note">Un regard naturellement sublimé</p>
    </div>

    <div class="lashlift-content">
      <p class="eyebrow">Beauté du regard</p>

      <h2>
        Lash Lift Coréen
        <span>à Marseille</span>
      </h2>

      <p class="intro">
        Une technique de rehaussement nouvelle génération pour ouvrir le regard,
        courber les cils naturels et révéler leur longueur, sans extensions.
      </p>

      <div class="benefits">
        <div class="benefit">
          <span class="icon">✦</span>

          <div>
            <strong>Cils naturels</strong>
            <p>Une courbure élégante sans ajout d’extensions.</p>
          </div>
        </div>

        <div class="benefit">
          <span class="icon">♡</span>

          <div>
            <strong>Regard ouvert</strong>
            <p>Un résultat doux, lumineux et naturel.</p>
          </div>
        </div>

        <div class="benefit">
          <span class="icon">✧</span>

          <div>
            <strong>Effet longue tenue</strong>
            <p>Des cils sublimés pendant plusieurs semaines.</p>
          </div>
        </div>
      </div>

      <div class="lashlift-footer">
        <div class="actions">
          <a class="primary-button" href="/reservation/"> Réserver </a>

          <a class="text-link" href="/lash-lift-coreen-marseille/">
            En savoir plus
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lashlift-section {
    position: relative;
    overflow: hidden;
    padding: 95px 0;
    background: #f2e5da;
  }

  .lashlift-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 85px;
  }

  .lashlift-visual {
    position: relative;
    width: 100%;
    max-width: 520px;
  }

  .image-wrapper {
    position: relative;
    height: 560px;
    overflow: hidden;
    border-radius: 150px 34px 34px 34px;

    box-shadow: 0 25px 65px rgba(99, 61, 45, 0.1);
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: 61% 37%;

    transform: scale(1.16);

    transition: transform 0.6s ease;
  }

  .image-wrapper:hover img {
    transform: scale(1.19);
  }

  .badge {
    position: absolute;
    top: 25px;
    right: 24px;
    z-index: 2;

    padding: 9px 17px;

    border-radius: 999px;

    background: var(--color-terracotta);
    color: white;

    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .visual-note {
    position: absolute;
    right: -30px;
    bottom: 28px;
    z-index: 3;

    max-width: 195px;

    padding: 16px 20px;

    border-radius: 22px;

    background: rgba(255, 253, 251, 0.93);

    color: var(--color-terracotta-dark);

    font-family: var(--font-title);
    font-size: 1.3rem;
    font-style: italic;
    line-height: 1.18;

    box-shadow: 0 15px 40px rgba(89, 54, 39, 0.1);

    backdrop-filter: blur(6px);
  }

  .lashlift-content {
    max-width: 570px;
  }

  .eyebrow {
    margin-bottom: 18px;

    color: var(--color-terracotta-dark);

    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(3rem, 4.8vw, 4.8rem);
    line-height: 1;
  }

  h2 span {
    display: block;
    margin-top: 5px;

    color: var(--color-terracotta);

    font-style: italic;
  }

  .intro {
    max-width: 540px;

    margin-top: 27px;

    color: var(--color-text-soft);

    font-size: 1.02rem;
    line-height: 1.75;
  }

  .benefits {
    display: grid;
    gap: 21px;
    margin-top: 35px;
  }

  .benefit {
    display: grid;
    grid-template-columns: 42px 1fr;
    align-items: start;
    gap: 15px;
  }

  .benefit .icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;

    border: 1px solid rgba(184, 111, 85, 0.28);
    border-radius: 50%;

    color: var(--color-terracotta);

    font-size: 1.15rem;
  }

  .benefit strong {
    display: block;
    margin-bottom: 3px;

    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .benefit p {
    color: var(--color-text-soft);
    font-size: 0.91rem;
  }

  .lashlift-footer {
    display: flex;
    justify-content: flex-start;
    margin-top: 38px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .primary-button {
    display: inline-flex;
    min-width: 115px;
    align-items: center;
    justify-content: center;

    padding: 14px 26px;

    border-radius: 999px;

    background: var(--color-terracotta);
    color: white;

    font-size: 0.9rem;
    font-weight: 500;

    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .primary-button:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-2px);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    color: var(--color-terracotta-dark);

    font-size: 0.9rem;
    font-weight: 500;
  }

  .text-link span {
    transition: transform 0.2s ease;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .lashlift-section {
      padding: 70px 0;
    }

    .lashlift-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .lashlift-visual {
      max-width: 620px;
      margin-inline: auto;
    }

    .image-wrapper {
      height: 500px;
    }

    .image-wrapper img {
      object-position: 60% 36%;
      transform: scale(1.14);
    }

    .lashlift-content {
      max-width: 620px;
      margin-inline: auto;
    }

    .visual-note {
      right: 20px;
    }
  }

  @media (max-width: 560px) {
    .lashlift-section {
      padding: 34px 0 46px;
    }

    .lashlift-grid {
      gap: 30px;
    }

    .lashlift-visual {
      width: 100%;
    }

    .image-wrapper {
      height: 320px;
      border-radius: 82px 22px 22px 22px;
    }

    .image-wrapper img {
      object-position: 62% 33%;
      transform: scale(1.24);
    }

    .image-wrapper:hover img {
      transform: scale(1.24);
    }

    .badge {
      top: 16px;
      right: 16px;

      padding: 8px 13px;

      font-size: 0.67rem;
    }

    .visual-note {
      right: 10px;
      bottom: 12px;

      max-width: 155px;

      padding: 12px 15px;

      border-radius: 18px;

      font-size: 1.02rem;
    }

    .eyebrow {
      margin-bottom: 14px;
      font-size: 0.7rem;
    }

    h2 {
      font-size: clamp(2.65rem, 11.5vw, 3.45rem);
    }

    .intro {
      margin-top: 20px;

      font-size: 0.98rem;
      line-height: 1.6;
    }

    .benefits {
      gap: 15px;
      margin-top: 27px;
    }

    .benefit {
      grid-template-columns: 38px 1fr;
      gap: 13px;
    }

    .benefit .icon {
      width: 38px;
      height: 38px;

      font-size: 1rem;
    }

    .benefit strong {
      margin-bottom: 2px;

      font-size: 1.08rem;
    }

    .benefit p {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .lashlift-footer {
      margin-top: 28px;
    }

    .actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 13px;
    }

    .primary-button {
      width: 100%;
      min-height: 52px;
    }

    .text-link {
      justify-content: center;
    }
  }
</style>
