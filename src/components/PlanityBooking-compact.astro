---
interface Props {
  services?: string[];
  serviceSets?: string[];
  servicesNotCollapsed?: boolean;
  containerId?: string;
  displayTitle?: string;
}

const {
  services = [],
  serviceSets = [],
  servicesNotCollapsed = true,
  containerId = "planity-appointment",
  displayTitle = "",
} = Astro.props;

const planityKey = import.meta.env.PUBLIC_PLANITY_KEY;

const options = {
  ...(services.length > 0 ? { servicesWhitelist: services } : {}),
  ...(serviceSets.length > 0 ? { serviceSetsWhitelist: serviceSets } : {}),
  ...(servicesNotCollapsed ? { servicesNotCollapsed: true } : {}),
};
---

<section class="planity-booking planity-booking--compact">
  <div class="planity-viewport" id={`${containerId}-viewport`}>
    <div class="planity-container" id={containerId}></div>
  </div>
</section>

<script define:vars={{ planityKey, options, containerId, displayTitle }}>
  const container = document.getElementById(containerId);
  const viewport = document.getElementById(`${containerId}-viewport`);

  if (container && viewport && planityKey) {
    window.planity = {
      key: planityKey,
      primaryColor: "#b86f55",
      appointmentContainer: container,
      options,
    };

    let raf = 0;
    let showMoreClickInProgress = false;
    let bookingFlowActive = false;

    const bookingRoot = container.closest(".planity-booking");
    let scrollAnchor = null;
    let scrollGuardUntil = 0;

    const isElementVisible = (element) => {
      if (!(element instanceof HTMLElement)) return false;

      const style = window.getComputedStyle(element);
      const rect = element.getBoundingClientRect();

      return (
        style.display !== "none" &&
        style.visibility !== "hidden" &&
        Number(style.opacity || 1) !== 0 &&
        rect.width > 0 &&
        rect.height > 0
      );
    };

    const getVisibleDialog = () =>
      [
        ...document.querySelectorAll('[role="dialog"], [aria-modal="true"]'),
      ].find((element) => isElementVisible(element));

    const isPlanityInteraction = (target) => {
      if (!(target instanceof Node)) return false;
      if (container.contains(target)) return true;

      const dialog = getVisibleDialog();
      return Boolean(dialog && dialog.contains(target));
    };

    const rememberScrollAnchor = () => {
      if (!(bookingRoot instanceof HTMLElement)) return;

      scrollAnchor = {
        rootTop: bookingRoot.getBoundingClientRect().top,
        scrollY: window.scrollY,
      };

      scrollGuardUntil = performance.now() + 1200;
    };

    const restoreScrollAnchor = () => {
      if (!scrollAnchor || performance.now() > scrollGuardUntil) return;
      if (!(bookingRoot instanceof HTMLElement)) return;

      const currentRootTop = bookingRoot.getBoundingClientRect().top;
      const drift = currentRootTop - scrollAnchor.rootTop;

      /*
       * Planity peut demander au navigateur de remonter brutalement pendant
       * un changement d'étape. On compense uniquement ce saut vertical ;
       * le défilement manuel de l'utilisatrice reste libre hors interaction.
       */
      if (Math.abs(drift) > 40) {
        window.scrollBy({ top: drift, left: 0, behavior: "auto" });
        return;
      }

      /* Sécurité supplémentaire pour le cas typique d'un retour à y = 0. */
      if (scrollAnchor.scrollY > 180 && window.scrollY < 80) {
        window.scrollTo({
          top: scrollAnchor.scrollY,
          left: 0,
          behavior: "auto",
        });
      }
    };

    const scheduleScrollRestore = () => {
      [0, 40, 100, 220, 450, 800].forEach((delay) => {
        window.setTimeout(() => {
          window.requestAnimationFrame(restoreScrollAnchor);
        }, delay);
      });
    };

    document.addEventListener(
      "click",
      (event) => {
        if (!isPlanityInteraction(event.target)) return;

        rememberScrollAnchor();
        scheduleScrollRestore();
      },
      true,
    );

    const resetCrop = () => {
      viewport.style.removeProperty("height");
      viewport.style.removeProperty("overflow");
      container.style.removeProperty("transform");
      container.style.removeProperty("transform-origin");
    };

    const isVisible = isElementVisible;

    const getChooseButtons = () =>
      [...container.querySelectorAll("button")].filter((button) => {
        return (
          button.textContent?.trim().toLowerCase() === "choisir" &&
          isVisible(button)
        );
      });

    const getShowMoreControl = () =>
      [...container.querySelectorAll("button, a")].find((element) => {
        if (!isVisible(element)) return false;

        const text = element.textContent?.trim().toLowerCase() || "";

        return /^voir\s+\d+\s+autre[s]?\s+prestation[s]?/.test(
          text.normalize("NFD").replace(/[\u0300-\u036f]/g, ""),
        );
      });

    const hasVisibleDialog = () =>
      [
        ...document.querySelectorAll('[role="dialog"], [aria-modal="true"]'),
      ].some((element) => isVisible(element));

    const replaceCategoryTitle = (firstRowTop) => {
      if (!displayTitle) return;

      const candidates = [
        ...container.querySelectorAll("h1,h2,h3,h4,h5,h6,div,p,span"),
      ].filter((element) => {
        if (!(element instanceof HTMLElement)) return false;
        if (!isVisible(element)) return false;

        const text = element.textContent?.trim();
        if (!text || text.length > 70) return false;
        if (text.toLowerCase() === "prendre un rdv") return false;

        const rect = element.getBoundingClientRect();

        return (
          rect.bottom <= firstRowTop + 16 && firstRowTop - rect.bottom < 130
        );
      });

      if (candidates.length) {
        const heading = candidates[candidates.length - 1];

        if (heading.textContent?.trim() !== displayTitle) {
          heading.textContent = displayTitle;
        }
      }
    };

    const compactInitialStep = () => {
      cancelAnimationFrame(raf);

      raf = requestAnimationFrame(() => {
        /*
         * Dès qu'une fenêtre Planity est ouverte (information,
         * identification, confirmation...), on laisse le widget totalement
         * libre : aucun recadrage ni transform ne doit perturber la modale.
         */
        if (hasVisibleDialog()) {
          resetCrop();
          return;
        }

        const chooseButtons = getChooseButtons();

        /*
         * Après un clic sur "Choisir", on ne recadre plus le widget tant que
         * la vraie liste des prestations n'est pas redevenue visible.
         * Cela évite qu'une liste cachée dans le DOM réactive le transform
         * pendant le calendrier ou l'identification.
         */
        if (bookingFlowActive) {
          if (!chooseButtons.length) {
            resetCrop();
            return;
          }

          bookingFlowActive = false;
        }

        const showMoreControl = getShowMoreControl();

        if (showMoreControl && !showMoreClickInProgress) {
          showMoreClickInProgress = true;
          showMoreControl.click();

          window.setTimeout(() => {
            showMoreClickInProgress = false;
            compactInitialStep();
          }, 120);

          return;
        }

        if (!chooseButtons.length) {
          resetCrop();
          return;
        }

        const rows = chooseButtons
          .map(
            (button) =>
              button.closest("li") ||
              button.closest('[itemprop="itemListElement"]') ||
              button.parentElement,
          )
          .filter((row) => row instanceof HTMLElement && isVisible(row));

        if (!rows.length) {
          resetCrop();
          return;
        }

        const containerRect = container.getBoundingClientRect();
        const firstRowRect = rows[0].getBoundingClientRect();
        const lastRowRect = rows[rows.length - 1].getBoundingClientRect();

        replaceCategoryTitle(firstRowRect.top);

        const topAllowance = window.innerWidth < 700 ? 88 : 105;

        const cropTop = Math.max(
          0,
          Math.round(firstRowRect.top - containerRect.top - topAllowance),
        );

        const visibleHeight = Math.ceil(
          lastRowRect.bottom -
            containerRect.top -
            cropTop +
            (window.innerWidth < 700 ? 26 : 30),
        );

        if (visibleHeight > 140 && visibleHeight < 760) {
          viewport.style.height = `${visibleHeight}px`;
          viewport.style.overflow = "hidden";

          container.style.transform = `translateY(-${cropTop}px)`;
          container.style.transformOrigin = "top left";
        } else {
          resetCrop();
        }
      });
    };

    container.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof HTMLElement)) return;

      const button = target.closest("button");

      if (button && button.textContent?.trim().toLowerCase() === "choisir") {
        bookingFlowActive = true;
        resetCrop();
      }
    });

    const observer = new MutationObserver(() => {
      compactInitialStep();
      scheduleScrollRestore();
    });

    observer.observe(container, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["style", "class", "aria-hidden", "aria-expanded"],
    });

    window.addEventListener("resize", compactInitialStep);

    [100, 300, 600, 1000, 1600, 2400].forEach((delay) => {
      window.setTimeout(compactInitialStep, delay);
    });
  }
</script>

<script
  is:inline
  src="https://d2skjte8udjqxw.cloudfront.net/widget/production/2/polyfills.latest.js"
></script>

<script
  is:inline
  src="https://d2skjte8udjqxw.cloudfront.net/widget/production/2/app.latest.js"
></script>

<style>
  .planity-booking,
  .planity-viewport,
  .planity-container {
    width: 100%;
  }

  .planity-booking {
    min-height: 0;
  }

  .planity-viewport {
    position: relative;
    min-height: 0;
    background: transparent;
  }

  .planity-container {
    min-height: 0;
    will-change: transform;
    background: transparent;
  }
</style>
