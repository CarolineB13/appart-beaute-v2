---
import MobileMenu from "./MobileMenu.astro";

const navLinks = [
  { label: "Prestations", href: "/#prestations" },
  { label: "L'institut", href: "/#institut" },
  { label: "Tarifs", href: "/#tarifs" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Appart & Beauté - Accueil">
      <img
        src="/logo/logo-appart-beaute.svg"
        alt="Appart & Beauté Institut"
        class="brand-logo"
      />
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="booking-button" href="/reservation/"> Réserver </a>

      <MobileMenu links={navLinks} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;

    width: 100%;

    padding: 14px 0;

    background: rgba(255, 253, 251, 0.97);

    border-bottom: 1px solid rgba(53, 39, 33, 0.05);

    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;
  }

  .brand {
    display: flex;

    align-items: center;

    flex-shrink: 0;
  }

  .brand-logo {
    display: block;

    width: 135px;
    height: auto;
  }

  .desktop-nav {
    display: none;
  }

  .header-actions {
    display: flex;

    align-items: center;

    gap: 8px;
  }

  /* Pas de bouton Réserver dans le header mobile */
  .booking-button {
    display: none;
  }

  @media (min-width: 600px) {
    .site-header {
      padding: 17px 0;
    }

    .brand-logo {
      width: 170px;
    }
  }

  @media (min-width: 901px) {
    .site-header {
      padding: 20px 0;
    }

    .brand-logo {
      width: 220px;
    }

    .desktop-nav {
      display: flex;

      align-items: center;

      gap: 28px;

      margin-left: auto;
    }

    .desktop-nav a {
      position: relative;

      font-size: 0.9rem;
    }

    .desktop-nav a::after {
      position: absolute;

      bottom: -6px;
      left: 0;

      width: 0;
      height: 1px;

      background: var(--color-terracotta);

      content: "";

      transition: width 0.25s ease;
    }

    .desktop-nav a:hover::after {
      width: 100%;
    }

    .header-actions {
      margin-left: 14px;
    }

    .booking-button {
      display: inline-flex;

      min-height: 46px;

      align-items: center;
      justify-content: center;

      padding: 11px 25px;

      border-radius: 999px;

      background: var(--color-terracotta);

      color: white;

      font-size: 0.9rem;
      font-weight: 500;

      transition:
        background 0.25s ease,
        transform 0.25s ease;
    }

    .booking-button:hover {
      background: var(--color-terracotta-dark);

      transform: translateY(-1px);
    }
  }
</style>
