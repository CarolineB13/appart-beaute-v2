---
import MobileMenu from "./MobileMenu.astro";

const navLinks = [
  { label: "Prestations", href: "/#prestations" },
  { label: "L'institut", href: "/#institut" },
  { label: "Tarifs", href: "/#tarifs" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Appart & Beauté - Accueil">
      <img
        src="/logo/logo-appart-beaute.svg"
        alt="Appart & Beauté Institut"
        class="brand-logo"
      />
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a class="booking-button" href="/reservation/"> Réserver </a>

    <MobileMenu links={navLinks} />
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 200;
    width: 100%;
    padding: 24px 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    width: 230px;
    height: auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    font-size: 0.92rem;
  }

  .desktop-nav a::after {
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-terracotta);
    content: "";
    transition: width 0.25s ease;
  }

  .desktop-nav a:hover::after {
    width: 100%;
  }

  .booking-button {
    padding: 14px 26px;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: white;
    font-size: 0.95rem;
    font-weight: 500;

    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .booking-button:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .header-inner {
      gap: 12px;
    }

    .brand-logo {
      width: 160px;
    }

    .booking-button {
      margin-left: auto;
      padding: 12px 20px;
      font-size: 0.9rem;
    }

    .site-header {
      padding: 18px 0;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      padding: 16px 0;
    }

    .brand-logo {
      width: 135px;
    }

    .booking-button {
      padding: 11px 18px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 390px) {
    .brand-logo {
      width: 120px;
    }

    .booking-button {
      padding: 10px 15px;
    }
  }
</style>
