---
import MobileMenu from "./MobileMenu.astro";

const links = [
  { label: "Prestations", href: "/prestations/" },
  { label: "L’institut", href: "/#institut" },
  { label: "Tarifs", href: "/tarifs/" },
  { label: "Contact", href: "/contact/" },
];
---

<header class="site-header" data-site-header>
  <div class="header-shell">
    <a href="/" class="header-logo" aria-label="Appart & Beauté - Accueil">
      <img src="/logo/logo-appart-beaute.svg" alt="Appart & Beauté" />
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a href="/reservation/" class="desktop-booking">
      Réserver
      <span>→</span>
    </a>

    <MobileMenu links={links} />
  </div>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const updateHeader = () => {
    if (!(header instanceof HTMLElement)) return;
    header.classList.toggle("is-scrolled", window.scrollY > 30);
  };
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>

<style>
  .site-header { position: fixed; z-index: 1000; top: 0; left: 0; width: 100%; padding: 11px 14px; transition: padding .3s ease; }
  .header-shell { display:flex; width:100%; max-width:1440px; min-height:58px; align-items:center; justify-content:space-between; margin-inline:auto; padding:0 3px; border:1px solid transparent; border-radius:22px; background:transparent; transition:min-height .3s ease,padding .3s ease,background .3s ease,border-color .3s ease,box-shadow .3s ease; }
  .header-logo { display:block; width:138px; transition:width .3s ease; }
  .header-logo img { display:block; width:100%; height:auto; }
  .site-header.is-scrolled { padding:7px 10px; }
  .site-header.is-scrolled .header-shell { min-height:54px; padding:0 8px 0 12px; border-color:rgba(159,83,61,.1); background:rgba(250,245,240,.97); box-shadow:0 8px 25px rgba(64,43,34,.08); }
  .site-header.is-scrolled .header-logo { width:116px; }
  .desktop-nav,.desktop-booking { display:none; }
  @media (min-width:901px) {
    .site-header { padding:14px 30px; }
    .header-shell { min-height:66px; padding:0 10px; }
    .header-logo { width:205px; }
    .desktop-nav { display:flex; align-items:center; gap:34px; margin-left:auto; margin-right:32px; }
    .desktop-nav a { position:relative; color:var(--color-text); font-size:.76rem; font-weight:500; letter-spacing:.06em; text-transform:uppercase; }
    .desktop-nav a::after { position:absolute; right:0; bottom:-7px; left:0; height:1px; background:var(--color-terracotta); content:""; transform:scaleX(0); transform-origin:right; transition:transform .25s ease; }
    .desktop-nav a:hover::after { transform:scaleX(1); transform-origin:left; }
    .desktop-booking { display:inline-flex; min-height:45px; align-items:center; justify-content:center; gap:13px; padding:11px 19px; border-radius:999px; background:var(--color-terracotta); color:white; font-size:.71rem; font-weight:600; letter-spacing:.07em; text-transform:uppercase; transition:background .25s ease,transform .25s ease; }
    .desktop-booking:hover { background:var(--color-terracotta-dark); transform:translateY(-2px); }
    .site-header.is-scrolled { padding:8px 24px; }
    .site-header.is-scrolled .header-shell { min-height:58px; padding:0 13px 0 17px; }
    .site-header.is-scrolled .header-logo { width:170px; }
  }
</style>
