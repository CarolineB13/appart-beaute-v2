---
const googleUrl = "https://maps.app.goo.gl/Zck271xbfqboAbqJ8";
const planityUrl = "https://www.planity.com/appart-beaute-13011-marseille";

const reviews = [
  {
    source: "google",
    rating: "5,0",
    count: "28 avis",
    text:
      "Excellente esthéticienne minutieuse et à l’écoute, très professionnelle. L’institut est très agréable et décoré avec goût.",
    desktopOnly: false,
  },
  {
    source: "planity",
    rating: "5,0",
    count: "174 avis",
    text:
      "Très professionnelle, accueillante, travail précis et bel institut. Je recommande les yeux fermés.",
    desktopOnly: false,
  },
  {
    source: "google",
    rating: "5,0",
    count: "28 avis",
    text:
      "Super contente de mes ongles et mon rehaussement ! Marjorie est très minutieuse et expérimentée ! Et l’institut est très joli et très propre !",
    desktopOnly: true,
  },
];
---

<section class="reviews-section" id="avis">
  <div class="container">
    <header class="reviews-heading" data-reveal>
      <p class="eyebrow">Vos avis</p>

      <h2>
        Leurs mots
        <span>parlent d’eux-mêmes</span>
      </h2>

      <span class="heading-line" aria-hidden="true"></span>
    </header>

    <div class="reviews-grid">
      {
        reviews.map((review, index) => (
          <article
            class:list={[
              "review-card",
              `review-card--${review.source}`,
              review.desktopOnly && "review-card--desktop-only",
            ]}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div class="review-header">
              <div class="review-brand">
                <img
                  src={
                    review.source === "google"
                      ? "/logo/google-g.svg"
                      : "/logo/planity.svg"
                  }
                  alt=""
                  class:list={[
                    "review-logo",
                    review.source === "google"
                      ? "review-logo--google"
                      : "review-logo--planity",
                  ]}
                  loading="lazy"
                />

                <div class="brand-copy">
                  <span class="brand-name">
                    {review.source === "google" ? "Google" : "Planity"}
                  </span>

                  <span class="brand-rating">
                    {review.rating} · {review.count}
                  </span>
                </div>
              </div>

              <span
                class:list={[
                  "review-stars",
                  review.source === "google"
                    ? "review-stars--google"
                    : "review-stars--planity",
                ]}
                aria-label="5 étoiles sur 5"
              >
                ★★★★★
              </span>
            </div>

            <p class="review-text">“{review.text}”</p>

            <a
              class="review-link"
              href={review.source === "google" ? googleUrl : planityUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Voir les avis sur {review.source === "google" ? "Google" : "Planity"}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 58px 0 72px;
    background: var(--color-bg-soft);
  }

  .reviews-heading {
    max-width: 620px;
  }

  .reviews-heading h2 {
    margin-top: 9px;
    color: var(--color-text);
    font-family: var(--font-title);
    font-size: clamp(2.85rem, 11vw, 3.85rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  .reviews-heading h2 span {
    display: block;
    color: var(--color-terracotta);
    font-style: italic;
  }

  .heading-line {
    display: block;
    width: 52px;
    height: 2px;
    margin-top: 18px;
    background: var(--color-terracotta);
  }

  .reviews-grid {
    display: grid;
    gap: 16px;
    margin-top: 38px;
  }

  .review-card {
    position: relative;
    padding: 22px 20px 21px;
    border: 1px solid rgba(53, 39, 33, 0.08);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 10px 30px rgba(73, 48, 39, 0.045);
  }

  .review-card--desktop-only {
    display: none;
  }

  .review-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .review-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
  }

  .review-logo {
    display: block;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .review-logo--google {
    width: 26px;
    height: 26px;
  }

  .review-logo--planity {
    width: 28px;
    height: 28px;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.2;
  }

  .brand-name {
    color: #202124;
    font-family: Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .review-card--planity .brand-name {
    color: #111;
  }

  .brand-rating {
    color: #6f6f6f;
    font-size: 0.66rem;
  }

  .review-stars {
    flex: 0 0 auto;
    font-size: 0.78rem;
    letter-spacing: 0.055em;
    line-height: 1;
    white-space: nowrap;
  }

  .review-stars--google {
    color: #fbbc04;
  }

  .review-stars--planity {
    color: #111;
  }

  .review-text {
    margin-top: 20px;
    color: var(--color-text);
    font-family: var(--font-title);
    font-size: clamp(1.26rem, 5.25vw, 1.6rem);
    font-weight: 500;
    line-height: 1.42;
  }

  .review-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(53, 39, 33, 0.18);
    color: #5f6368;
    font-size: 0.75rem;
    font-weight: 500;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .review-card--planity .review-link {
    color: #333;
  }

  .review-link span {
    transition: transform 0.25s ease;
  }

  .review-link:hover {
    border-color: rgba(159, 83, 61, 0.36);
    color: var(--color-terracotta-dark);
  }

  .review-link:hover span {
    transform: translateX(4px);
  }

  @media (min-width: 700px) and (max-width: 999px) {
    .reviews-section {
      padding: 80px 0 88px;
    }

    .reviews-heading h2 {
      font-size: 4.7rem;
    }

    .reviews-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 44px;
    }

    .review-card {
      padding: 24px 22px 23px;
    }

    .review-text {
      font-size: 1.52rem;
    }
  }

  @media (min-width: 1000px) {
    .reviews-section {
      padding: 92px 0 100px;
    }

    .reviews-heading h2 {
      font-size: clamp(4.35rem, 5.15vw, 5.45rem);
    }

    .heading-line {
      width: 68px;
      margin-top: 20px;
    }

    .reviews-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 50px;
    }

    .review-card,
    .review-card--desktop-only {
      display: block;
      min-height: 310px;
      padding: 26px 25px 24px;
      border-radius: 26px;
    }

    .review-text {
      font-size: 1.45rem;
      line-height: 1.43;
    }

    .review-link {
      position: absolute;
      bottom: 24px;
      left: 25px;
    }
  }

  @media (max-width: 390px) {
    .reviews-section {
      padding: 50px 0 62px;
    }

    .reviews-heading h2 {
      font-size: 2.7rem;
    }

    .reviews-grid {
      margin-top: 34px;
    }

    .review-card {
      padding: 20px 18px 19px;
    }

    .review-text {
      font-size: 1.18rem;
    }

    .review-logo--google {
      width: 24px;
      height: 24px;
    }

    .review-logo--planity {
      width: 26px;
      height: 26px;
    }

    .brand-name {
      font-size: 0.86rem;
    }

    .brand-rating {
      font-size: 0.63rem;
    }
  }
</style>
