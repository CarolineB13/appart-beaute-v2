---
import { Image } from "astro:assets";

import accueilInstitutDesktop from "../assets/images/institut/desktop/accueil-institut-desktop.webp";
import institutCabineDesktop from "../assets/images/institut/desktop/institut-cabine-desktop.webp";
import institutOnglerieDesktop from "../assets/images/institut/desktop/institut-onglerie-desktop.webp";
import institutPrincipaleDesktop from "../assets/images/institut/desktop/institut-principale-desktop.webp";

import institutCabineMobile from "../assets/images/institut/mobile/institut-cabine-mobile.webp";
import institutOnglerieMobile from "../assets/images/institut/mobile/institut-onglerie-mobile.webp";
import institutPrincipaleMobile from "../assets/images/institut/mobile/institut-principale-mobile.webp";
---

<section class="institut-section" id="institut">
  <div class="container">
    <header class="institut-heading" data-reveal>
      <p class="eyebrow">L’institut</p>

      <h2 class="section-title">
        L’univers
        <span>Appart & Beauté</span>
      </h2>

      <span class="section-line" aria-hidden="true"></span>

      <p class="institut-intro">
        Un lieu chaleureux et intimiste, pensé pour votre bien-être au cœur de
        La Valentine.
      </p>
    </header>

    <!-- =====================================================
         MOBILE : GALERIE ÉDITORIALE ANIMÉE
         ===================================================== -->

    <div class="institut-mobile-gallery">
      <figure
        class="institut-photo-card institut-photo-card--main"
        data-reveal="image"
        style="--reveal-delay: 70ms"
      >
        <Image
          src={institutPrincipaleMobile}
          alt="Espace principal de l’institut Appart & Beauté à La Valentine"
          class="institut-photo"
          widths={[420, 560, 720]}
          sizes="(max-width: 699px) 82vw, 560px"
          loading="lazy"
        />
      </figure>

      <div class="institut-photo-pair">
        <figure
          class="institut-photo-card institut-photo-card--cabine"
          data-reveal="image"
          style="--reveal-delay: 140ms"
        >
          <Image
            src={institutCabineMobile}
            alt="Cabine de soin de l’institut Appart & Beauté"
            class="institut-photo"
            widths={[280, 380, 480]}
            sizes="(max-width: 699px) 43vw, 340px"
            loading="lazy"
          />
        </figure>

        <figure
          class="institut-photo-card institut-photo-card--onglerie"
          data-reveal="image"
          style="--reveal-delay: 210ms"
        >
          <Image
            src={institutOnglerieMobile}
            alt="Espace onglerie de l’institut Appart & Beauté"
            class="institut-photo"
            widths={[300, 400, 520]}
            sizes="(max-width: 699px) 49vw, 380px"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="institut-mobile-note" data-reveal style="--reveal-delay: 245ms">
        <p>Une parenthèse pensée pour vous.</p>
        <span>Douceur · intimité</span>
      </div>
    </div>

    <!-- =====================================================
         DESKTOP : MOSAÏQUE ÉDITORIALE
         ===================================================== -->

    <div class="institut-desktop-gallery">
      <div class="institut-mosaic">
        <figure
          class="mosaic-card mosaic-card--main"
          data-reveal="image"
          style="--reveal-delay: 70ms"
        >
          <Image
            src={accueilInstitutDesktop}
            alt="Vue de l’univers Appart & Beauté à La Valentine"
            class="mosaic-photo"
            widths={[700, 900, 1100]}
            sizes="(min-width: 1000px) 44vw, 700px"
            loading="lazy"
          />
        </figure>

        <figure
          class="mosaic-card mosaic-card--cabine"
          data-reveal="image"
          style="--reveal-delay: 140ms"
        >
          <Image
            src={institutCabineDesktop}
            alt="Cabine de soin de l’institut Appart & Beauté"
            class="mosaic-photo"
            widths={[520, 680, 820]}
            sizes="(min-width: 1000px) 34vw, 560px"
            loading="lazy"
          />
        </figure>

        <figure
          class="mosaic-card mosaic-card--principale"
          data-reveal="image"
          style="--reveal-delay: 210ms"
        >
          <Image
            src={institutPrincipaleDesktop}
            alt="Espace principal de l’institut Appart & Beauté"
            class="mosaic-photo"
            widths={[360, 480, 620]}
            sizes="(min-width: 1000px) 22vw, 420px"
            loading="lazy"
          />
        </figure>

        <figure
          class="mosaic-card mosaic-card--onglerie"
          data-reveal="image"
          style="--reveal-delay: 245ms"
        >
          <Image
            src={institutOnglerieDesktop}
            alt="Espace onglerie de l’institut Appart & Beauté"
            class="mosaic-photo"
            widths={[360, 480, 620]}
            sizes="(min-width: 1000px) 22vw, 420px"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="institut-desktop-note" data-reveal style="--reveal-delay: 245ms">
        <p>Un lieu pensé pour que chaque rendez-vous soit une vraie parenthèse.</p>
        <span>Douceur · lumière · intimité</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* =====================================================
     SECTION
     ===================================================== */

  .institut-section {
    position: relative;
    overflow: hidden;
    padding: var(--section-space-top) 0 var(--section-space-bottom);
    background: var(--color-bg-warm);
  }

  /* =====================================================
     TITRE
     ===================================================== */

  .institut-heading {
    max-width: 590px;
  }

  .institut-intro {
    max-width: 510px;
    margin-top: 18px;
    font-size: 0.96rem;
    line-height: 1.65;
  }

  /* =====================================================
     MOBILE — COMPOSITION ÉDITORIALE
     ===================================================== */

  .institut-desktop-gallery {
    display: none;
  }

  .institut-mobile-gallery {
    margin-top: 36px;
  }

  .institut-photo-card {
    position: relative;
    overflow: hidden;
    background: var(--color-beige);
    box-shadow: var(--shadow-soft);
  }

  .institut-photo-card--main {
    width: calc(100% - 24px);
    height: 420px;
    margin-left: auto;
    border-radius: 108px 26px 26px 26px;
  }

  .institut-photo-pair {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    align-items: end;
    gap: 14px;
    margin-top: -30px;
    padding-right: 10px;
  }

  .institut-photo-card--cabine {
    height: 205px;
    border-radius: 24px 24px 72px 24px;
  }

  .institut-photo-card--onglerie {
    height: 260px;
    border-radius: 24px 78px 24px 24px;
  }

  .institut-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .institut-photo-card--main .institut-photo {
    object-position: center 48%;
  }

  .institut-photo-card--cabine .institut-photo {
    object-position: center 45%;
  }

  .institut-photo-card--onglerie .institut-photo {
    object-position: center 50%;
  }

  .institut-mobile-note {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px;
    margin-top: 22px;
  }

  .institut-mobile-note p {
    max-width: 210px;
    color: var(--color-text);
    font-family: var(--font-title);
    font-size: 1.16rem;
    line-height: 1.25;
  }

  .institut-mobile-note span {
    flex: 0 0 auto;
    color: var(--color-terracotta-dark);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* =====================================================
     PETITS MOBILES
     ===================================================== */

  @media (max-width: 390px) {
    .institut-mobile-gallery {
      margin-top: 34px;
    }

    .institut-photo-card--main {
      height: 385px;
    }

    .institut-photo-card--cabine {
      height: 185px;
    }

    .institut-photo-card--onglerie {
      height: 235px;
    }

    .institut-mobile-note {
      gap: 14px;
    }

    .institut-mobile-note p {
      max-width: 180px;
      font-size: 1.05rem;
    }

    .institut-mobile-note span {
      font-size: 0.57rem;
    }
  }

  /* =====================================================
     TABLETTE
     ===================================================== */

  @media (min-width: 700px) and (max-width: 999px) {
    .institut-heading {
      max-width: 670px;
    }

    .institut-intro {
      font-size: 1rem;
    }

    .institut-mobile-gallery {
      max-width: 720px;
      margin-top: 46px;
      margin-inline: auto;
    }

    .institut-photo-card--main {
      width: calc(100% - 80px);
      height: 520px;
    }

    .institut-photo-pair {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 18px;
      margin-top: -48px;
      padding-right: 24px;
    }

    .institut-photo-card--cabine {
      height: 250px;
    }

    .institut-photo-card--onglerie {
      height: 330px;
    }

    .institut-mobile-note {
      margin-top: 30px;
    }

    .institut-mobile-note p {
      max-width: none;
      font-size: 1.3rem;
    }

    .institut-mobile-note span {
      font-size: 0.7rem;
    }
  }

  /* =====================================================
     DESKTOP — MOSAÏQUE PREMIUM
     ===================================================== */

  @media (min-width: 1000px) {
    .institut-mobile-gallery {
      display: none;
    }

    .institut-desktop-gallery {
      display: block;
      margin-top: 50px;
    }

    .institut-heading {
      display: grid;
      max-width: none;
      grid-template-columns: 1fr 0.78fr;
      grid-template-areas:
        "eyebrow eyebrow"
        "title intro"
        "line intro";
      column-gap: 78px;
      align-items: end;
    }

    .institut-heading .eyebrow {
      grid-area: eyebrow;
    }

    .institut-heading .section-title {
      grid-area: title;
    }

    .institut-heading .section-line {
      grid-area: line;
      justify-self: start;
    }

    .institut-intro {
      grid-area: intro;
      align-self: end;
      margin-top: 0;
      padding-bottom: 6px;
      font-size: 1rem;
    }

    .institut-mosaic {
      display: grid;
      grid-template-columns: 1.18fr 0.78fr 0.78fr;
      grid-template-rows: 270px 245px;
      gap: 18px;
    }

    .mosaic-card {
      position: relative;
      overflow: hidden;
      background: var(--color-beige);
      box-shadow: var(--shadow-soft);
    }

    .mosaic-card--main {
      grid-column: 1;
      grid-row: 1 / 3;
      border-radius: 145px 30px 30px 30px;
    }

    .mosaic-card--cabine {
      grid-column: 2 / 4;
      grid-row: 1;
      border-radius: 30px 118px 30px 30px;
    }

    .mosaic-card--principale {
      grid-column: 2;
      grid-row: 2;
      border-radius: 30px 30px 30px 92px;
    }

    .mosaic-card--onglerie {
      grid-column: 3;
      grid-row: 2;
      border-radius: 30px 30px 92px 30px;
    }

    .mosaic-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.65s ease;
    }

    .mosaic-card--main .mosaic-photo {
      object-position: center 50%;
    }

    .mosaic-card--cabine .mosaic-photo {
      object-position: center 48%;
    }

    .mosaic-card--principale .mosaic-photo {
      object-position: center 50%;
    }

    .mosaic-card--onglerie .mosaic-photo {
      object-position: center 50%;
    }

    .mosaic-card:hover .mosaic-photo {
      transform: scale(1.025);
    }

    .institut-desktop-note {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 40px;
      margin-top: 28px;
    }

    .institut-desktop-note p {
      max-width: 570px;
      color: var(--color-text);
      font-family: var(--font-title);
      font-size: 1.26rem;
      line-height: 1.4;
    }

    .institut-desktop-note span {
      flex: 0 0 auto;
      color: var(--color-terracotta-dark);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }
  }

  /* =====================================================
     GRAND DESKTOP
     ===================================================== */

  @media (min-width: 1400px) {
    .institut-heading {
      column-gap: 90px;
    }

    .institut-desktop-gallery {
      margin-top: 54px;
    }

    .institut-mosaic {
      grid-template-rows: 300px 270px;
      gap: 20px;
    }
  }
</style>
