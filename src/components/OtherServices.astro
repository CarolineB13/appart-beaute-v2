---
import { Image } from "astro:assets";

import regardImage from "../assets/images/regard/prestation-regard.webp";
import onglerieImage from "../assets/images/prestations/prestation-onglerie.webp";
import epilationImage from "../assets/images/prestations/prestation-epilation.webp";
---

<section class="other-services" id="prestations">
  <div class="container services-container">
    <header class="services-heading" data-reveal>
      <p class="eyebrow">Prendre soin de soi</p>

      <h2 class="section-title">Nos prestations</h2>

      <span class="section-line" aria-hidden="true"></span>
    </header>

    <div class="services-editorial">
      <!-- REGARD — prestation prioritaire -->
      <a
        class="service-card service-card--regard"
        href="/prestations/#regard"
        data-reveal="image"
        style="--reveal-delay: 70ms"
      >
        <Image
          src={regardImage}
          alt="Beauté du regard chez Appart & Beauté à La Valentine Marseille 11e"
          class="service-photo"
          widths={[520, 720, 960, 1200]}
          sizes="(min-width: 1000px) 55vw, 100vw"
          loading="lazy"
        />

        <span class="service-overlay" aria-hidden="true"></span>

        <div class="service-content">
          <p class="service-label">Cils & sourcils</p>

          <h3>Regard</h3>

          <p class="service-description">
            Lash Lift Coréen, browlift, rehaussement et extensions de cils.
          </p>

          <span class="service-link">
            Découvrir
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>

      <!-- ONGLERIE -->
      <a
        class="service-card service-card--onglerie"
        href="/onglerie-la-valentine/"
        data-reveal="image"
        style="--reveal-delay: 140ms"
      >
        <Image
          src={onglerieImage}
          alt="Onglerie chez Appart & Beauté à La Valentine Marseille 11e"
          class="service-photo"
          widths={[420, 620, 820]}
          sizes="(min-width: 1000px) 38vw, 100vw"
          loading="lazy"
        />

        <span class="service-overlay" aria-hidden="true"></span>

        <div class="service-content">
          <p class="service-label">Beauté des mains</p>

          <h3>Onglerie</h3>

          <p class="service-description">
            Des mains soignées et une mise en beauté élégante, jusque dans les détails.
          </p>

          <span class="service-link">
            Découvrir
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>

      <!-- ÉPILATION -->
      <a
        class="service-card service-card--epilation"
        href="/epilation-la-valentine/"
        data-reveal="image"
        style="--reveal-delay: 210ms"
      >
        <Image
          src={epilationImage}
          alt="Épilation chez Appart & Beauté à La Valentine Marseille 11e"
          class="service-photo"
          widths={[420, 620, 820]}
          sizes="(min-width: 1000px) 38vw, 100vw"
          loading="lazy"
        />

        <span class="service-overlay" aria-hidden="true"></span>

        <div class="service-content">
          <p class="service-label">Douceur & soin</p>

          <h3>Épilation</h3>

          <p class="service-description">
            Des prestations femme et homme réalisées avec précision et douceur.
          </p>

          <span class="service-link">
            Découvrir
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    </div>

    <div class="services-bottom" data-reveal style="--reveal-delay: 175ms">
      <a href="/prestations/" class="all-services">
        Découvrir toutes les prestations
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* =====================================================
     SECTION
     ===================================================== */

  .other-services {
    padding: var(--section-space-top) 0 54px;
    background: var(--color-bg-soft);
  }

  .services-container {
    max-width: 1180px;
  }

  .services-heading {
    margin-bottom: 34px;
  }

  /* =====================================================
     CARTES — MOBILE FIRST
     ===================================================== */

  .services-editorial {
    display: grid;
    gap: 16px;
  }

  .service-card {
    position: relative;
    display: block;
    min-height: 390px;
    overflow: hidden;
    isolation: isolate;
    border-radius: 30px;
    background: var(--color-beige);
    box-shadow: 0 14px 38px rgba(86, 54, 42, 0.07);
  }

  .service-card--regard {
    min-height: 440px;
    border-radius: 92px 28px 28px 28px;
  }

  .service-card--onglerie {
    border-radius: 28px 82px 28px 28px;
  }

  .service-card--epilation {
    border-radius: 28px 28px 82px 28px;
  }

  .service-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card--regard .service-photo {
    object-position: 52% 45%;
  }

  .service-card--onglerie .service-photo {
    object-position: center 48%;
  }

  .service-card--epilation .service-photo {
    object-position: center 48%;
  }

  .service-card:hover .service-photo {
    transform: scale(1.025);
  }

  .service-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(53, 39, 33, 0.03) 22%,
        rgba(53, 39, 33, 0.16) 49%,
        rgba(53, 39, 33, 0.78) 100%
      );
  }

  .service-content {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 28px 27px 27px;
    color: white;
  }

  .service-label {
    margin-bottom: 7px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .service-content h3 {
    margin: 0;
    color: white;
    font-family: var(--font-title);
    font-size: clamp(2.7rem, 12vw, 3.65rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .service-description {
    max-width: 500px;
    margin-top: 12px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.46);
    color: white;
    font-size: 0.86rem;
    font-weight: 500;
  }

  .service-link span {
    transition: transform 0.25s ease;
  }

  .service-card:hover .service-link span {
    transform: translateX(4px);
  }

  /* =====================================================
     LIEN FINAL
     ===================================================== */

  .services-bottom {
    display: flex;
    justify-content: flex-end;
    margin-top: 24px;
  }

  .all-services {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(159, 83, 61, 0.32);
    color: var(--color-terracotta-dark);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .all-services span {
    transition: transform 0.25s ease;
  }

  .all-services:hover span {
    transform: translateX(4px);
  }

  /* =====================================================
     PETITS MOBILES
     ===================================================== */

  @media (max-width: 390px) {
    .services-heading {
      margin-bottom: 30px;
    }

    .service-card {
      min-height: 355px;
      border-radius: 26px;
    }

    .service-card--regard {
      min-height: 405px;
      border-radius: 78px 24px 24px 24px;
    }

    .service-card--onglerie {
      border-radius: 24px 68px 24px 24px;
    }

    .service-card--epilation {
      border-radius: 24px 24px 68px 24px;
    }

    .service-content {
      padding: 24px 22px 23px;
    }

    .service-content h3 {
      font-size: 2.55rem;
    }

    .service-description {
      font-size: 0.86rem;
    }
  }

  /* =====================================================
     TABLETTE
     ===================================================== */

  @media (min-width: 700px) and (max-width: 999px) {
    .other-services {
      padding-bottom: 82px;
    }

    .services-heading {
      margin-bottom: 40px;
    }

    .services-editorial {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .service-card {
      min-height: 390px;
    }

    .service-card--regard {
      grid-column: 1 / -1;
      min-height: 480px;
    }

    .service-content {
      padding: 30px;
    }

    .service-content h3 {
      font-size: 3.35rem;
    }
  }

  /* =====================================================
     DESKTOP — COMPOSITION ASYMÉTRIQUE
     ===================================================== */

  @media (min-width: 1000px) {
    .other-services {
      padding-bottom: var(--section-space-bottom);
    }

    .services-heading {
      margin-bottom: 44px;
    }

    .services-editorial {
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
      grid-template-rows: 300px 300px;
      gap: 20px;
    }

    .service-card {
      min-height: 0;
    }

    .service-card--regard {
      grid-column: 1;
      grid-row: 1 / 3;
      border-radius: 150px 32px 32px 32px;
    }

    .service-card--onglerie {
      grid-column: 2;
      grid-row: 1;
      border-radius: 32px 105px 32px 32px;
    }

    .service-card--epilation {
      grid-column: 2;
      grid-row: 2;
      border-radius: 32px 32px 105px 32px;
    }

    .service-content {
      padding: 31px 32px 30px;
    }

    .service-card--regard .service-content {
      padding: 38px 40px 38px;
    }

    .service-content h3 {
      font-size: 3.25rem;
    }

    .service-card--regard .service-content h3 {
      font-size: clamp(4rem, 4.5vw, 5rem);
    }

    .service-description {
      max-width: 430px;
      font-size: 0.92rem;
    }

    .service-card--regard .service-description {
      max-width: 520px;
      font-size: 0.98rem;
    }

    .services-bottom {
      margin-top: 30px;
    }
  }

  /* =====================================================
     GRAND DESKTOP
     ===================================================== */

  @media (min-width: 1400px) {
    .services-editorial {
      grid-template-rows: 330px 330px;
      gap: 22px;
    }

    .service-card--regard {
      border-radius: 165px 34px 34px 34px;
    }

    .service-card--onglerie {
      border-radius: 34px 118px 34px 34px;
    }

    .service-card--epilation {
      border-radius: 34px 34px 118px 34px;
    }
  }
</style>
